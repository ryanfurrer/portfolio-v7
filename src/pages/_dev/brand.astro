---
import AtomMark from "@/components/AtomMark.astro";
import Callout from "@/components/Callout.astro";
import CtaLink from "@/components/CtaLink.astro";
import Item from "@/components/Item.astro";
import CodeBlock from "@/components/sanity/CodeBlock.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import TocMobile from "@/components/TocMobile.tsx";
import Layout from "@/layouts/Layout.astro";

// Dev-only page (injected in astro.config only when `command === "dev"`), so it
// carries its own copy rather than a public SECTION_META entry, and skips the
// OG card that the section generator would otherwise emit.
const title = "Brand";
const description =
  "The identity this site is built from — one reserved accent, a restrained type system, and the components behind every page.";

// Hand-authored outline — the ids below must match each section's heading id so
// the scroll-spy ToC (which observes them) tracks correctly.
const headings = [
  { id: "principles", text: "Principles", level: 2 },
  { id: "mark", text: "Mark", level: 2 },
  { id: "color", text: "Color", level: 2 },
  { id: "typography", text: "Typography", level: 2 },
  { id: "voice", text: "Voice", level: 2 },
  { id: "elevation", text: "Elevation & surfaces", level: 2 },
  { id: "radius", text: "Radius", level: 2 },
  { id: "motion", text: "Motion", level: 2 },
  { id: "components", text: "Components", level: 2 },
  { id: "links", text: "Links & CTAs", level: 3 },
  { id: "lists", text: "List rows", level: 3 },
  { id: "feedback", text: "Badges & callouts", level: 3 },
  { id: "code", text: "Prose & code", level: 3 },
  { id: "accessibility", text: "Accessibility", level: 2 },
];

// Load-bearing neutrals — the palette that does 95% of the work.
const coreTokens = [
  { token: "--background", label: "Canvas", util: "bg-background", note: "Off-white page base — white cards lift above it." },
  { token: "--card", label: "Card", util: "bg-card", note: "Raised white surface for elevated content." },
  { token: "--surface", label: "Surface", util: "bg-surface", note: "Recessed well — inline code, hovers." },
  { token: "--surface-hover", label: "Surface hover", util: "bg-surface-hover", note: "The well, one step deeper." },
  { token: "--foreground", label: "Ink — primary", util: "text-foreground", note: "Headings and key copy." },
  { token: "--foreground-muted", label: "Ink — muted", util: "text-foreground-muted", note: "Body and descriptions." },
  { token: "--foreground-subtle", label: "Ink — subtle", util: "text-foreground-subtle", note: "Captions, meta, dates." },
  { token: "--badge", label: "Badge", util: "bg-badge", note: "Neutral metadata pill." },
  { token: "--border", label: "Border", util: "border-border", note: "Hairline — opacity-based per surface." },
];

// The one reserved hue + the semantic tokens.
const accentTokens = [
  { token: "--brand", label: "Viridian — brand", util: "text-brand", note: "Logo and text selection. Personality only." },
  { token: "--brand-strong", label: "Viridian — AA text", util: "text-brand-strong", note: "Brand-coloured text that clears 4.5:1." },
  { token: "--primary", label: "Primary", util: "bg-primary", note: "Inverse ink fill — active nav, buttons." },
  { token: "--ring", label: "Focus ring", util: "ring-ring", note: "Keyboard focus — neutral gray." },
  { token: "--destructive", label: "Destructive", util: "text-destructive", note: "Errors and danger." },
];

const radii = ["sm", "md", "lg", "xl", "2xl", "3xl", "4xl"] as const;

const easings = [
  { name: "ease-out", curve: "cubic-bezier(0, 0, 0.2, 1)", use: "Hover / press micro-interactions." },
  { name: "ease-ios", curve: "cubic-bezier(0.23, 1, 0.32, 1)", use: "Overlays and drawers — a slower settle." },
];

const voice = [
  { trait: "Plainspoken", note: "Say the true thing simply. Jargon has to earn its place." },
  { trait: "Craft-forward", note: "The details are the story — show the care, not the process." },
  { trait: "Warm, first-person", note: "A person, not a brand. Written the way I'd say it out loud." },
  { trait: "Considered", note: "Restraint in words as in pixels — cut until only the clear part is left." },
];

const sampleCode = `// One pseudo-element per list follows the hovered row.
const { top, height } = row.getBoundingClientRect();
list.style.setProperty("--dir-hover-y", \`\${top}px\`);
list.style.setProperty("--dir-hover-h", \`\${height}px\`);`;
---

<Layout title={`${title} — Ryan Furrer`} description={description}>
  <!-- Desktop: back link in the left gutter, ToC in the right (matching articles) -->
  <div slot="left" class="sticky top-20">
    <CtaLink href="/" direction="back">Home</CtaLink>
  </div>
  <TableOfContents slot="right" headings={headings} />

  <main class="space-y-16">
    <header class="space-y-3">
      <h1 class="text-3xl text-balance text-foreground sm:text-4xl" data-reveal>
        {title}
      </h1>
      <p class="lead max-w-[52ch]" data-reveal>{description}</p>
      <p class="max-w-[60ch] text-pretty" data-reveal>
        The top half is the brand — the mark, the colour, the type, the voice.
        Below it is the system those choices produce. Every swatch reads its
        value live from the cascade, so nothing here can drift; flip the theme in
        the header to watch each one resolve for dark mode.
      </p>
    </header>

    <!-- ── Principles (ethos) ─────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="principles">
      <h2 id="principles" class="text-2xl text-foreground">Principles</h2>
      <ul class="space-y-3 text-pretty" role="list">
        <li>
          <strong class="font-semibold text-foreground">One reserved accent.</strong>{" "}
The system is neutral grayscale ink on an off-white canvas. A single
          viridian hue carries personality — the logo and text selection — and
          never does load-bearing work.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Ink is the interaction colour.</strong>{" "}
Links, active states, and fills use the foreground itself (black in
          light, white in dark), not a hue. Emphasis comes from weight and
          contrast, not colour.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Depth over borders.</strong>{" "}
Surfaces separate with a hairline ring plus a soft shadow in light
          mode, and a bright inset hairline in dark — rarely a solid 1px line.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Restraint, then whitespace.</strong>{" "}
Two easing curves, one radius scale, a small type system. Impact is
          bought with proportion and space, not more components.
        </li>
      </ul>
    </section>

    <!-- ═══ Brand tier ════════════════════════════════════════════════ -->
    <div class="flex items-center gap-4" aria-hidden="true">
      <span class="small-heading">Brand</span>
      <span class="h-px flex-1 bg-border"></span>
    </div>

    <!-- ── 001 Mark ───────────────────────────────────────────────────── -->
    <section class="space-y-5" data-reveal aria-labelledby="mark">
      <h2 id="mark" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">001</span>
        Mark
      </h2>
      <p class="max-w-[60ch] text-pretty">
        An atom — a nucleus with two orbits — drawn in a single stroke weight. It
        points at the one thing my initials, my signature, and this mark all
        stand for: the person making the work. Reproduce it in one colour —
        viridian, or neutral ink where the accent would compete.
      </p>

      <div class="grid gap-4 sm:grid-cols-3">
        <figure class="space-y-2">
          <div class="relative grid aspect-square place-items-center rounded-lg bg-surface [box-shadow:inset_0_0_0_1px_var(--border)]">
            <span class="absolute inset-[22%] rounded-sm border border-dashed border-border" aria-hidden="true"></span>
            <AtomMark class="size-16 stroke-brand" decorative />
          </div>
          <figcaption class="text-sm text-pretty text-foreground-muted">
            <span class="font-medium text-foreground">Clear space.</span> Keep open
            space around the mark at least half its height on every side.
          </figcaption>
        </figure>

        <figure class="space-y-2">
          <div class="grid aspect-square place-items-center rounded-lg bg-surface [box-shadow:inset_0_0_0_1px_var(--border)]">
            <div class="flex items-end gap-4">
              <AtomMark class="size-8 stroke-foreground" decorative />
              <AtomMark class="size-4 stroke-foreground" decorative />
            </div>
          </div>
          <figcaption class="text-sm text-pretty text-foreground-muted">
            <span class="font-medium text-foreground">Minimum 16px.</span> Any
            smaller and the orbits blur into the nucleus.
          </figcaption>
        </figure>

        <figure class="space-y-2">
          <!-- Fixed dark tile + dark-mode viridian (#44b98e), so the reversed
               treatment reads the same regardless of the page's active theme.
               Ring is 20% white so the tile stays framed even in dark mode,
               where its fill matches the page canvas. -->
          <div class="grid aspect-square place-items-center rounded-lg bg-[#0e0e0e] [box-shadow:inset_0_0_0_1px_#ffffff33]">
            <AtomMark class="size-16 stroke-[#44b98e]" decorative />
          </div>
          <figcaption class="text-sm text-pretty text-foreground-muted">
            <span class="font-medium text-foreground">On dark.</span> Switch to the
            dark-mode viridian so it holds contrast on near-black.
          </figcaption>
        </figure>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href="/brand/ryan-furrer-mark.svg"
          download
          class="inline-flex items-center gap-2 rounded-md bg-surface px-3 py-1.5 text-sm font-medium text-foreground transition-colors [box-shadow:inset_0_0_0_1px_var(--border)] hover:bg-surface-hover"
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 2v8m0 0 3-3m-3 3L5 7M2.5 12.5h11" />
          </svg>
          Download SVG
        </a>
        <p class="font-mono-custom text-xs text-foreground-subtle">
          single stroke · viridian · scales to any size
        </p>
      </div>

      <dl class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg bg-surface p-4 [box-shadow:inset_0_0_0_1px_var(--border)]">
          <dt class="text-xs font-semibold uppercase tracking-wide text-brand-strong">Do</dt>
          <dd class="mt-1 text-sm text-pretty">Keep it one colour, give it room, and let the stroke weight breathe.</dd>
        </div>
        <div class="rounded-lg bg-surface p-4 [box-shadow:inset_0_0_0_1px_var(--border)]">
          <dt class="text-xs font-semibold uppercase tracking-wide text-foreground-subtle">Don't</dt>
          <dd class="mt-1 text-sm text-pretty">Recolour it per background, stretch it, or add shadows and gradients.</dd>
        </div>
      </dl>
    </section>

    <!-- ── 002 Color ──────────────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="color">
      <h2 id="color" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">002</span>
        Color
      </h2>
      <p class="text-pretty">
        Values below are read live from the cascade with
        <code class="rounded-sm bg-surface px-1.5 py-0.5 font-mono-custom text-foreground [box-shadow:inset_0_0_0_1px_var(--border)]"
          >getComputedStyle</code
        >, so they always match the active theme.
      </p>

      <h3 class="small-heading pt-2">Core — load-bearing neutrals</h3>
      <ul class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2" role="list">
        {
          coreTokens.map((t) => (
            <li class="flex items-center gap-4">
              <span
                class="size-14 shrink-0 rounded-lg [box-shadow:inset_0_0_0_1px_var(--border)]"
                style={`background-color: var(${t.token})`}
                aria-hidden="true"
              />
              <div class="min-w-0">
                <p class="font-medium text-foreground">{t.label}</p>
                <p class="font-mono-custom text-xs text-foreground-subtle">
                  {t.util} · <span data-token={t.token}>…</span>
                </p>
                <p class="mt-0.5 text-sm text-pretty">{t.note}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="small-heading pt-4">Accent &amp; semantic</h3>
      <ul class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2" role="list">
        {
          accentTokens.map((t) => (
            <li class="flex items-center gap-4">
              <span
                class="size-14 shrink-0 rounded-lg [box-shadow:inset_0_0_0_1px_var(--border)]"
                style={`background-color: var(${t.token})`}
                aria-hidden="true"
              />
              <div class="min-w-0">
                <p class="font-medium text-foreground">{t.label}</p>
                <p class="font-mono-custom text-xs text-foreground-subtle">
                  {t.util} · <span data-token={t.token}>…</span>
                </p>
                <p class="mt-0.5 text-sm text-pretty">{t.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── 003 Typography ─────────────────────────────────────────────── -->
    <section class="space-y-6" data-reveal aria-labelledby="typography">
      <h2 id="typography" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">003</span>
        Typography
      </h2>

      <div class="space-y-5">
        <div>
          <p class="font-sans text-5xl font-extrabold tracking-[-0.03em] text-foreground">
            Geist
          </p>
          <p class="mt-1 font-mono-custom text-xs text-foreground-subtle">
            font-sans · display &amp; body · variable 100–900
          </p>
        </div>
        <div>
          <p class="font-mono text-4xl text-foreground">Berkeley Mono</p>
          <p class="mt-1 font-mono-custom text-xs text-foreground-subtle">
            font-mono · UI labels, metadata, dates
          </p>
        </div>
        <div>
          <p class="font-cursive text-4xl text-foreground">-Ryan</p>
          <p class="mt-1 font-mono-custom text-xs text-foreground-subtle">
            font-cursive · Permanent Marker · signature only
          </p>
        </div>
      </div>

      <h3 class="small-heading pt-2">Scale &amp; roles</h3>
      <dl class="space-y-4">
        <div class="flex flex-col gap-1 border-t border-border pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dd class="text-3xl font-extrabold tracking-[-0.022em] text-foreground sm:text-4xl">
            Display heading
          </dd>
          <dt class="font-mono-custom text-xs text-foreground-subtle">
            h1 · text-3xl/4xl · 800
          </dt>
        </div>
        <div class="flex flex-col gap-1 border-t border-border pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dd class="text-2xl font-extrabold tracking-[-0.022em] text-foreground">
            Section heading
          </dd>
          <dt class="font-mono-custom text-xs text-foreground-subtle">
            h2 · text-2xl · 800
          </dt>
        </div>
        <div class="flex flex-col gap-1 border-t border-border pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dd class="lead max-w-none">Standfirst / lede — the opening voice.</dd>
          <dt class="font-mono-custom text-xs text-foreground-subtle">.lead</dt>
        </div>
        <div class="flex flex-col gap-1 border-t border-border pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dd class="text-foreground-muted">
            Body copy — muted ink, the default reading colour.
          </dd>
          <dt class="font-mono-custom text-xs text-foreground-subtle">
            p · text-foreground-muted
          </dt>
        </div>
        <div class="flex flex-col gap-1 border-t border-border pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dd class="small-heading">Eyebrow label</dd>
          <dt class="font-mono-custom text-xs text-foreground-subtle">
            .small-heading · mono
          </dt>
        </div>
        <div class="flex flex-col gap-1 border-t border-border pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dd class="font-mono-custom text-foreground">12.34 · tabular figures</dd>
          <dt class="font-mono-custom text-xs text-foreground-subtle">
            .font-mono-custom
          </dt>
        </div>
      </dl>
    </section>

    <!-- ── 004 Voice ──────────────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="voice">
      <h2 id="voice" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">004</span>
        Voice
      </h2>
      <p class="max-w-[60ch] text-pretty">
        The same restraint as the pixels, applied to words. When I write — here,
        in a post, in a UI label — it should sound like this.
      </p>
      <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {
          voice.map((v) => (
            <div class="border-t border-border pt-3">
              <dt class="font-medium text-foreground">{v.trait}</dt>
              <dd class="mt-0.5 text-sm text-pretty">{v.note}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ═══ System tier ═══════════════════════════════════════════════ -->
    <div class="flex items-center gap-4" aria-hidden="true">
      <span class="small-heading">System</span>
      <span class="h-px flex-1 bg-border"></span>
    </div>

    <!-- ── 005 Elevation ──────────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="elevation">
      <h2 id="elevation" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">005</span>
        Elevation &amp; surfaces
      </h2>
      <p class="text-pretty">
        Hover the raised card — it physically lifts on hover-capable pointers.
      </p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="card-raised squircle rounded-lg p-5">
          <p class="font-medium text-foreground">Raised card</p>
          <p class="mt-1 font-mono-custom text-xs text-foreground-subtle">.card-raised</p>
          <p class="mt-2 text-sm text-pretty">White surface, hairline ring, hover-lift.</p>
        </div>
        <div class="rounded-lg bg-card p-5 shadow-elevated">
          <p class="font-medium text-foreground">Soft elevation</p>
          <p class="mt-1 font-mono-custom text-xs text-foreground-subtle">shadow-elevated</p>
          <p class="mt-2 text-sm text-pretty">Apple-style whisper shadow, flat in dark.</p>
        </div>
        <div class="rounded-lg bg-surface p-5 [box-shadow:inset_0_0_0_1px_var(--border)]">
          <p class="font-medium text-foreground">Recessed well</p>
          <p class="mt-1 font-mono-custom text-xs text-foreground-subtle">bg-surface</p>
          <p class="mt-2 text-sm text-pretty">One step below the canvas — sunken.</p>
        </div>
      </div>
    </section>

    <!-- ── 006 Radius ─────────────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="radius">
      <h2 id="radius" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">006</span>
        Radius
      </h2>
      <p class="text-pretty">
        Every step derives from <code
          class="rounded-sm bg-surface px-1.5 py-0.5 font-mono-custom text-foreground [box-shadow:inset_0_0_0_1px_var(--border)]"
          >--radius</code
        > (0.375rem) via calc. <code
          class="rounded-sm bg-surface px-1.5 py-0.5 font-mono-custom text-foreground [box-shadow:inset_0_0_0_1px_var(--border)]"
          >.squircle</code
        > opts an element into continuous corners where supported.
      </p>
      <ul class="flex flex-wrap gap-4" role="list">
        {
          radii.map((r) => (
            <li class="flex flex-col items-center gap-2">
              <span
                class:list={[
                  "size-16 bg-primary/10 [box-shadow:inset_0_0_0_1px_var(--border)]",
                  `rounded-${r}`,
                ]}
                aria-hidden="true"
              />
              <span class="font-mono-custom text-xs text-foreground-subtle">
                rounded-{r}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── 007 Motion ─────────────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="motion">
      <h2 id="motion" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">007</span>
        Motion
      </h2>
      <p class="text-pretty">
        Two curves only. Hover the demo to compare the settle; durations stay as
        Tailwind utilities (150ms micro, 200ms highlight, 250–300ms overlays).
      </p>
      <div class="motion-demo space-y-4">
        {
          easings.map((e, i) => (
            <div>
              <div class="mb-1.5 flex items-baseline justify-between gap-4">
                <span class="font-medium text-foreground">{e.name}</span>
                <span class="font-mono-custom text-xs text-foreground-subtle">{e.curve}</span>
              </div>
              <div class="flex items-center rounded-full bg-surface p-1.5 [box-shadow:inset_0_0_0_1px_var(--border)]">
                <span class:list={["motion-dot size-6 rounded-full bg-brand", `motion-dot--${i}`]} aria-hidden="true" />
              </div>
              <p class="mt-1 text-sm text-pretty">{e.use}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── 008 Components ─────────────────────────────────────────────── -->
    <section class="space-y-4" data-reveal aria-labelledby="components">
      <h2 id="components" class="flex items-baseline gap-3 text-2xl text-foreground">
        <span class="font-mono-custom text-sm font-normal text-foreground-subtle" aria-hidden="true">008</span>
        Components
      </h2>

      <h3 id="links" class="text-lg font-semibold text-foreground">Links &amp; CTAs</h3>
      <p class="text-pretty">
        Inline links read as foreground ink with a faint underline and reveal on
        hover — like <a href="/writing">this one</a>. Standalone
        <span class="quiet-link">quiet links</span> drop the underline for nav-style
        lists. Directional CTAs travel toward their intent:
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
        <CtaLink href="/about">Forward</CtaLink>
        <CtaLink href="/" direction="back">Back</CtaLink>
        <CtaLink href="https://ryanfurrer.com" direction="external">External</CtaLink>
      </div>

      <h3 id="lists" class="pt-4 text-lg font-semibold text-foreground">List rows</h3>
      <p class="text-pretty">
        The <code
          class="rounded-sm bg-surface px-1.5 py-0.5 font-mono-custom text-foreground [box-shadow:inset_0_0_0_1px_var(--border)]"
          >Item</code
        > row with the shared traveling-highlight — one pill follows the cursor.
      </p>
      <ul class="flex flex-col gap-px" role="list" data-dir-hover-list="items">
        <li>
          <Item title="Crafting the traveling highlight" href="/writing" publishedAt="2026-07-15" />
        </li>
        <li>
