---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Unique per instance: duplicate gradient ids across repeated inline SVGs are
// invalid and all references collapse onto the first definition.
const id = `hearth-orb-${crypto.randomUUID().slice(0, 8)}`;
---

{/* The Hearth mark: the ember orb from the extension icon, rebuilt as a
    transparent radial gradient so it carries its own depth on any header,
    light or dark — no baked-in background to fight the surface. */}
<svg
  class={className}
  viewBox="0 0 24 24"
  role="img"
  aria-label="Hearth"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id={id} cx="42%" cy="36%" r="66%">
      <stop offset="0%" stop-color="#ff9a63"></stop>
      <stop offset="46%" stop-color="#f05a29"></stop>
      <stop offset="100%" stop-color="#bf3f18"></stop>
    </radialGradient>
  </defs>
  <circle cx="12" cy="12" r="10" fill={`url(#${id})`}></circle>
</svg>
