---
import ModeToggle from "./ModeToggle";
import Presence from "./Presence";
import SocialLinks from "./SocialLinks.astro";
import Wordmark from "./Wordmark.astro";

const currentYear = new Date().getFullYear();
---

<!-- z-30 keeps the footer above the ScrollFade gradient (z-20). pb-20 lifts the
     bottom row clear of the fixed "Back to top" button on content pages;
     lg:pb-0 drops it once that button sits out in the right gutter. -->
<footer class="relative z-30 border-t border-border pt-8 pb-20 lg:pb-0">
  <div class="space-y-10">
    <div class="space-y-3">
      <div class="space-y-2">
        <a
          href="/"
          class="flex w-fit items-center text-foreground"
          name="go to home page"
        >
          <Wordmark />
        </a>
        <p class="text-sm text-balance">
          Built with Astro and React, hosted on Vercel, and set in Google Sans
          and Berkeley Mono.
        </p>
      </div>
      <Presence plain client:idle />
    </div>
    <div
      class="flex flex-col gap-4 text-sm text-subtle-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {currentYear} Ryan Furrer</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <SocialLinks />
        <ModeToggle client:idle />
      </div>
    </div>
  </div>
</footer>
