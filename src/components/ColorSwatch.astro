---
interface Props {
  token: string;
  label: string;
  util: string;
  note: string;
}

const { token, label, util, note } = Astro.props;
---

<button
  type="button"
  data-swatch={token}
  aria-label={`Copy the ${label} colour value`}
  class="group/sw -mx-2 grid w-full grid-cols-[auto_minmax(0,1fr)_auto_auto] items-start gap-x-4 rounded-md px-2 py-2.5 text-start transition-[background-color,scale] duration-150 ease-out hover:bg-accent focus-visible:bg-accent focus-visible:outline-none active:scale-[0.99]"
>
  <span
    class="mt-0.5 size-7 shrink-0 rounded-md ring-1 ring-inset ring-border"
    style={`background-color: var(${token})`}
    aria-hidden="true"></span>
  <span class="min-w-0">
    <span class="flex items-baseline gap-2">
      <span class="truncate font-medium text-foreground">{label}</span>
      <span class="font-mono-custom shrink-0 text-xs text-muted-foreground"
        >{token}</span
      >
    </span>
    <span class="mt-0.5 block text-xs text-pretty text-muted-foreground">{note}</span
    >
  </span>
  <span class="mt-0.5 flex flex-col items-end gap-0.5 text-end">
    <span
      data-swatch-value
      class="font-mono-custom text-xs tabular-nums text-subtle-foreground transition-colors group-[.is-copied]/sw:text-brand"
      >…</span
    >
    <span class="font-mono-custom text-xs text-muted-foreground">{util}</span>
  </span>
  <svg
    class="mt-0.5 size-4 shrink-0 text-muted-foreground opacity-0 transition-opacity can-hover:group-hover/sw:opacity-100 group-focus-visible/sw:opacity-100 group-[.is-copied]/sw:text-brand group-[.is-copied]/sw:opacity-100"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
    <path
      d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"
    ></path>
  </svg>
</button>
