---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import HearthEditor from "./HearthEditor.astro";
import HearthMark from "./HearthMark.astro";
import HearthPalette from "./HearthPalette.astro";
import VariantGallery from "./VariantGallery.astro";
import {
  CLI_INSTALL,
  GITHUB_URL,
  MARKETPLACE_URL,
} from "@/lib/hearth/flavors";

const principles = [
  {
    title: "A warm, quiet base",
    body: "Backgrounds, text, and comments stay in warm neutrals. Nothing competes with the code you're reading.",
  },
  {
    title: "One accent, on purpose",
    body: "Keywords carry a single orange ember. Teal and Azure add just one cool hue — on functions and types — so structure pops without a rainbow.",
  },
  {
    title: "Light, dark, and Shiki",
    body: "Six variants across three flavors, each with a light and dark pair. The same theme files highlight code here and anywhere Shiki runs.",
  },
];
---

<div class="mx-auto max-w-5xl space-y-24 px-6 py-16 sm:py-24">
  <section class="space-y-8" data-reveal>
    <div class="space-y-5">
      <span class="flex items-center gap-2.5">
        <HearthMark class="size-8" />
        <span class="small-heading !text-subtle-foreground"
          >Theme for VS Code &amp; Cursor</span
        >
      </span>
      <h1
        class="text-5xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl"
      >
        Hearth
      </h1>
      <p class="lead max-w-xl !text-xl">
        A warm color theme that keeps the interface calm and lets a single
        accent pick out the code worth scanning.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <a
        href={MARKETPLACE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants({ size: "lg" })}
      >
        Install for VS Code
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants({ variant: "outline", size: "lg" })}
      >
        View on GitHub
      </a>
    </div>
  </section>

  <section class="space-y-5" data-reveal>
    <HearthEditor />
    <p class="text-center text-sm text-muted-foreground">
      The switcher is live — and this page highlights its own code with Hearth.
    </p>
  </section>

  <section class="grid gap-x-10 gap-y-8 sm:grid-cols-3" data-reveal>
    {
      principles.map((principle) => (
        <div class="space-y-2">
          <h2 class="text-base font-medium text-foreground">
            {principle.title}
          </h2>
          <p class="text-sm text-subtle-foreground text-pretty">
            {principle.body}
          </p>
        </div>
      ))
    }
  </section>

  <section class="space-y-6">
    <div class="space-y-2" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        Install
      </h2>
      <p class="text-subtle-foreground text-pretty">
        Grab it from the Marketplace, or run one command. Then open the theme
        picker with <kbd class="hearth-kbd">⌘K</kbd>
        <kbd class="hearth-kbd">⌘T</kbd> and choose a Hearth.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
      <button
        type="button"
        class="hearth-cmd group"
        data-copy={CLI_INSTALL}
        aria-label={`Copy install command: ${CLI_INSTALL}`}
      >
        <span class="hearth-cmd-prompt" aria-hidden="true">$</span>
        <code class="hearth-cmd-text">{CLI_INSTALL}</code>
        <span class="hearth-cmd-hint" aria-hidden="true">Copy</span>
      </button>
      <a
        href={MARKETPLACE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={cn(buttonVariants({ variant: "outline" }), "sm:ms-auto")}
      >
        Open in Marketplace
      </a>
    </div>
  </section>

  <section class="space-y-8">
    <div class="space-y-2" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        Six variants
      </h2>
      <p class="max-w-xl text-subtle-foreground text-pretty">
        Three flavors, each a light and dark pair. Every card below is rendered
        in its own theme — regardless of the mode you're viewing the page in.
      </p>
    </div>
    <VariantGallery />
  </section>

  <section class="space-y-8">
    <div class="space-y-2" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        The palette
      </h2>
      <p class="max-w-xl text-subtle-foreground text-pretty">
        The warm base is identical across flavors; only functions and types take
        on the accent hue. Every value is the real one from the theme files —
        click to copy.
      </p>
    </div>
    <HearthPalette />
  </section>

  <section
    class="flex flex-col items-start gap-5 border-t border-border pt-12"
    data-reveal
  >
    <h2 class="text-2xl font-semibold tracking-tight text-balance text-foreground">
      Make your editor feel like home.
    </h2>
    <a
      href={MARKETPLACE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonVariants({ size: "lg" })}
    >
      Install Hearth
    </a>
  </section>
</div>

<style>
  .hearth-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.05rem 0.35rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .hearth-cmd {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-lg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    cursor: pointer;
    transition: translate 150ms var(--ease-out-curve);
  }
  .hearth-cmd:active {
    translate: 0 1px;
  }
  .hearth-cmd:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .hearth-cmd-prompt {
    color: var(--brand);
  }
  .hearth-cmd-text {
    color: var(--foreground);
  }
  .hearth-cmd-hint {
    margin-inline-start: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--subtle-foreground);
  }
  .hearth-cmd.is-copied .hearth-cmd-hint {
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-cmd {
      transition: none;
    }
  }
</style>

<script>
  const status = document.createElement("span");
  status.className = "sr-only";
  status.setAttribute("role", "status");
  status.setAttribute("aria-live", "polite");
  document.body.appendChild(status);

  for (const cmd of document.querySelectorAll<HTMLButtonElement>(".hearth-cmd")) {
    const hint = cmd.querySelector<HTMLElement>(".hearth-cmd-hint");
    let timer = 0;
    cmd.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmd.dataset.copy ?? "");
        cmd.classList.add("is-copied");
        if (hint) hint.textContent = "Copied";
        status.textContent = "Command copied to clipboard";
      } catch {
        status.textContent = "Copy failed";
        return;
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        cmd.classList.remove("is-copied");
        if (hint) hint.textContent = "Copy";
        status.textContent = "";
      }, 1100);
    });
  }
</script>
