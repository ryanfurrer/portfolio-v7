---
import { hearthOrbSvg } from "@/lib/hearth/mark";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Unique per instance: duplicate gradient ids across repeated inline SVGs are
// invalid and all references collapse onto the first definition.
const id = `hearth-orb-${crypto.randomUUID().slice(0, 8)}`;
---

<Fragment set:html={hearthOrbSvg({ id, class: className })} />
