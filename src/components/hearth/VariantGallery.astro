---
import { Code } from "astro:components";
import HearthCodeWindow from "./HearthCodeWindow.astro";
import { FLAVORS, GALLERY_FILE, GALLERY_SAMPLE } from "@/lib/hearth/flavors";

const modes = [
  { key: "light", label: "Light" },
  { key: "dark", label: "Dark" },
] as const;

// Shiki's ThemeRegistrationRaw type marks `settings` as required, but the runtime
// consumes VS Code `tokenColors`; the vendored Hearth JSON is valid at load. The
// cast bridges that gap (mirrors CodeBlock.astro).
const asTheme = (themes: { light: unknown; dark: unknown }) => themes as never;
---

<div class="hearth-gallery space-y-10">
  {
    FLAVORS.map((flavor) => (
      <div class="space-y-4" data-reveal>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="flex items-center gap-2 text-lg font-medium text-foreground">
            <span
              class="size-2.5 rounded-full"
              style={`background-color: ${flavor.accent.dark}`}
              aria-hidden="true"
            />
            {flavor.fullName}
          </h3>
          <p class="text-sm text-muted-foreground">{flavor.tagline}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {modes.map((mode) => (
            <figure class="space-y-2">
              <HearthCodeWindow file={GALLERY_FILE} pin={mode.key} dense>
                <Code
                  code={GALLERY_SAMPLE}
                  lang="ts"
                  themes={asTheme(flavor.themes)}
                  defaultColor={false}
                  data-shiki-pin={mode.key}
                  wrap={true}
                />
              </HearthCodeWindow>
              <figcaption class="text-xs text-subtle-foreground">
                {mode.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>
