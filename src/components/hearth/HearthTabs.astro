---
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  label: string;
  /** Namespaces tab/panel ids so multiple tab groups can share a page. */
  idPrefix: string;
  /** When set, the selected tab is mirrored to this URL query param. */
  param?: string;
  class?: string;
}

const { tabs, label, idPrefix, param, class: className } = Astro.props;
---

<div
  class:list={["hearth-tabs space-y-6", className]}
  data-hearth-tabs
  data-tab-param={param}
>
  <div
    class="hearth-tablist flex gap-1 border-b border-border"
    role="tablist"
    aria-label={label}
  >
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`${idPrefix}-tab-${tab.id}`}
          aria-controls={`${idPrefix}-panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-tab-id={tab.id}
          class="hearth-tab"
        >
          {tab.label}
        </button>
      ))
    }
    <span class="hearth-tab-underline" data-tab-underline aria-hidden="true"
    ></span>
  </div>

  <slot />
</div>

<style>
  .hearth-tablist {
    position: relative;
  }
  .hearth-tab {
    position: relative;
    padding: 0.5rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    font-size: 0.9375rem;
    color: var(--subtle-foreground);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .hearth-tab::before {
    content: "";
    position: absolute;
    inset-block: -0.125rem;
    inset-inline: 0;
  }
  .hearth-tab:hover {
    color: var(--foreground);
  }
  .hearth-tab[aria-selected="true"] {
    color: var(--foreground);
    border-bottom-color: var(--brand);
  }
  .hearth-tabs[data-tab-underline-ready] .hearth-tab[aria-selected="true"] {
    border-bottom-color: transparent;
  }
  .hearth-tab:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  @media (min-width: 40rem) {
    .hearth-tab {
      padding-inline: 0.875rem;
    }
  }
  .hearth-tab-underline {
    position: absolute;
    inset-block-end: -1px;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: 2px;
    border-radius: var(--radius-full);
    background-color: var(--brand);
    opacity: 0;
    transform: translateX(0) scaleX(1);
    transform-origin: 0 50%;
    pointer-events: none;
    transition:
      transform 200ms cubic-bezier(0.645, 0.045, 0.355, 1),
      opacity 150ms var(--ease-out-curve);
  }
  .hearth-tab-underline[data-snap] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-tab,
    .hearth-tab-underline {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-hearth-tabs]",
  )) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (!tabs.length) continue;

    const tablist = root.querySelector<HTMLElement>(".hearth-tablist");
    const underline = root.querySelector<HTMLElement>("[data-tab-underline]");
    const param = root.dataset.tabParam;
    const tabId = (tab: HTMLButtonElement) => tab.dataset.tabId ?? "";
    const tabsById = new Map(tabs.map((tab) => [tabId(tab), tab]));

    const tabFromUrl = () => {
      if (!param) return tabs[0];
      const value = new URL(window.location.href).searchParams.get(param);
      return (value && tabsById.get(value)) || tabs[0];
    };

    const replaceUrl = (tab: HTMLButtonElement) => {
      if (!param) return;
      const url = new URL(window.location.href);
      url.searchParams.set(param, tabId(tab));
      url.hash = param;
      window.history.replaceState(window.history.state, "", url);
    };

    const moveUnderline = (tab: HTMLButtonElement, animate: boolean) => {
      if (!tablist || !underline) return;

      const currentRect = underline.getBoundingClientRect();
      const listRect = tablist.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      const ready = underline.hasAttribute("data-ready");
      const rtl = getComputedStyle(tablist).direction === "rtl";
      const inlineStart = rtl
        ? listRect.right - tabRect.right
        : tabRect.left - listRect.left;

      underline.setAttribute("data-snap", "");
      underline.style.insetInlineStart = `${inlineStart}px`;
      underline.style.inlineSize = `${tabRect.width}px`;
      underline.style.transform = "translateX(0) scaleX(1)";
      underline.style.opacity = "1";

      const targetRect = underline.getBoundingClientRect();
      if (animate && ready) {
        const delta = currentRect.left - targetRect.left;
        const scale = currentRect.width / targetRect.width;
        underline.style.transform = `translateX(${delta}px) scaleX(${scale})`;
      }

      underline.getBoundingClientRect();
      underline.removeAttribute("data-snap");
      underline.setAttribute("data-ready", "");
      root.setAttribute("data-tab-underline-ready", "");

      if (animate && ready) {
        requestAnimationFrame(() => {
          underline.style.transform = "translateX(0) scaleX(1)";
        });
      }
    };

    const select = (
      tab: HTMLButtonElement,
      focus = false,
      animate = false,
      updateUrl = false,
    ) => {
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute("aria-selected", active ? "true" : "false");
        other.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(
          other.getAttribute("aria-controls") ?? "",
        );
        if (panel) panel.hidden = !active;
      }
      moveUnderline(tab, animate);
      if (updateUrl) replaceUrl(tab);
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab, false, true, true));
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step) {
          event.preventDefault();
          select(
            tabs[(index + step + tabs.length) % tabs.length],
            true,
            false,
            true,
          );
        } else if (event.key === "Home") {
          event.preventDefault();
          select(tabs[0], true, false, true);
        } else if (event.key === "End") {
          event.preventDefault();
          select(tabs[tabs.length - 1], true, false, true);
        }
      });
    });

    select(tabFromUrl());
    if (param) {
      window.addEventListener("popstate", () =>
        select(tabFromUrl(), false, true),
      );
    }
    if (tablist) {
      new ResizeObserver(() => {
        const active = tabs.find(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        if (active) moveUnderline(active, false);
      }).observe(tablist);
    }
  }
</script>
