---
import { sanityClient } from "sanity:client";
import Container from "@/components/Container.astro";
import LatestItemsSection from "@/components/LatestItemsSection.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import Layout from "@/layouts/Layout.astro";
import { socialLinks } from "@/lib/social-links";
import { SITE_DESCRIPTION } from "@/consts";
import { LATEST_ITEMS_QUERY } from "@/sanity/lib/queries";
import type { LATEST_ITEMS_QUERY_RESULT } from "@/sanity/sanity.types";

const latestItems =
  await sanityClient.fetch<LATEST_ITEMS_QUERY_RESULT>(LATEST_ITEMS_QUERY);

// Person entity for the site — links the profile to every social account so
// search engines can associate them (knowledge-panel eligibility).
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ryan Furrer",
  url: Astro.site?.toString(),
  jobTitle: "Frontend Engineer and Designer",
  description: SITE_DESCRIPTION,
  image: new URL("/og-image.png", Astro.site).toString(),
  sameAs: socialLinks.map((link) => link.href),
};
---

<Layout jsonLd={personJsonLd}>
  <main class="space-y-16">
    <section class="space-y-8">
      <h1
        class="text-[clamp(1.875rem,1.1rem+2.8vw,3rem)]/[1.1] font-semibold tracking-tight text-pretty text-foreground"
        data-reveal
      >
        I am a Frontend Engineer who feels at home where design and engineering
        meet.
        <span class="text-muted-foreground">
          {" "}Crafting interfaces down to the last detail.
        </span>
      </h1>

      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-[2fr_1fr]" data-reveal>
        <div class="space-y-2">
          <span class="small-heading inline-block">Now</span>
          <p class="text-lg">
            Design Engineer at <a href="https://pragma.gg">Pragma</a>, part of
            the team creating the platform that helps studios build successful
            games, <a href="https://firstlook.gg">FirstLook</a>.
          </p>
        </div>
        <div class="space-y-2">
          <span class="small-heading inline-block">Connect</span>
          <SocialLinks orientation="vertical" size="lg" />
        </div>
      </div>
    </section>
    <Container>
      <LatestItemsSection title="Latest" items={latestItems} />
    </Container>
  </main>
</Layout>
