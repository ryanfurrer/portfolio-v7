---
import HearthSwatchGroup from "./HearthSwatchGroup.astro";
import HearthTabs from "./HearthTabs.astro";
import {
  BASE_PALETTE,
  FLAVORS,
  TERMINAL_PALETTE,
  type PaletteGroup,
} from "@/lib/hearth/flavors";

const ideGroups: PaletteGroup[] = [
  { heading: "Base — shared by every flavor", rows: BASE_PALETTE },
  {
    heading: "Accent — what each flavor changes",
    rows: FLAVORS.map((flavor) => ({
      label: flavor.fullName,
      note:
        flavor.id === "duotone"
          ? "keywords; functions and types stay neutral"
          : "functions, with a lighter tint on types",
      light: flavor.accent.light,
      dark: flavor.accent.dark,
    })),
  },
];

const targets = [
  { id: "ide", label: "IDE", groups: ideGroups },
  { id: "terminal", label: "Terminal", groups: TERMINAL_PALETTE },
];
---

<HearthTabs tabs={targets} label="Palette surface" idPrefix="hearth-palette">
  {
    targets.map((target, index) => (
      <div
        id={`hearth-palette-panel-${target.id}`}
        role="tabpanel"
        aria-labelledby={`hearth-palette-tab-${target.id}`}
        tabindex="0"
        class="space-y-8"
        hidden={index !== 0}
      >
        {target.groups.map((group) => (
          <HearthSwatchGroup heading={group.heading} rows={group.rows} />
        ))}
      </div>
    ))
  }
  <span class="sr-only" role="status" aria-live="polite" data-swatch-status
  ></span>
</HearthTabs>

<script>
  const status = document.querySelector<HTMLElement>("[data-swatch-status]");
  const timers = new WeakMap<HTMLElement, number>();

  document.addEventListener("click", async (event) => {
    const chip = (event.target as HTMLElement)?.closest<HTMLButtonElement>(
      ".hearth-chip",
    );
    if (!chip) return;
    const value = chip.dataset.copy ?? "";
    try {
      await navigator.clipboard.writeText(value);
      chip.classList.add("is-copied");
      if (status) status.textContent = `Copied ${value}`;
    } catch {
      if (status) status.textContent = "Copy failed";
      return;
    }
    window.clearTimeout(timers.get(chip));
    timers.set(
      chip,
      window.setTimeout(() => {
        chip.classList.remove("is-copied");
        if (status) status.textContent = "";
      }, 1500),
    );
  });
</script>
