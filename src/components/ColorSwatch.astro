---
interface Props {
  token: string;
  label: string;
  note: string;
}

const { token, label, note } = Astro.props;
---

<button
  type="button"
  data-swatch={token}
  aria-label={`Copy the ${label} colour value`}
  class="group/sw -mx-2 grid w-full grid-cols-[auto_minmax(0,1fr)_auto_auto] items-start gap-x-4 rounded-md px-2 py-2.5 text-start transition-[translate] duration-150 ease-out focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none active:translate-y-px"
>
  <span
    class="mt-0.5 size-7 shrink-0 rounded-md ring-1 ring-inset ring-border"
    style={`background-color: var(${token})`}
    aria-hidden="true"></span>
  <span class="min-w-0">
    <span class="flex items-baseline gap-2">
      <span class="truncate font-medium text-foreground">{label}</span>
      <span class="font-mono-custom shrink-0 text-xs text-subtle-foreground"
        >{token}</span
      >
    </span>
    <span class="mt-0.5 block text-sm text-pretty text-subtle-foreground">{note}</span
    >
  </span>
  <span
    data-swatch-value
    class="mt-0.5 font-mono-custom text-xs tabular-nums text-foreground"
    >…</span
  >
  <span class="relative mt-1 size-4 shrink-0" aria-hidden="true">
    <svg
      class="absolute inset-0 size-4 text-subtle-foreground opacity-0 transition-opacity duration-150 ease-out can-hover:group-hover/sw:opacity-100 group-focus-visible/sw:opacity-100 group-[.is-copied]/sw:opacity-0!"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
      <path
        d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"
      ></path>
    </svg>
    <svg
      class="absolute inset-0 size-4 scale-90 text-brand opacity-0 transition-[opacity,scale] duration-200 ease-out group-[.is-copied]/sw:scale-100 group-[.is-copied]/sw:opacity-100"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3.5 8.5 6.5 11.5 12.5 5"></path>
    </svg>
  </span>
</button>
