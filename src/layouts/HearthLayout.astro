---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Head from "@/components/Head.astro";
import HearthMark from "@/components/hearth/HearthMark.astro";
import ModeToggle from "@/components/ModeToggle";
import { buttonVariants } from "@/components/ui/button";
import { GITHUB_URL, MARKETPLACE_URL } from "@/lib/hearth/flavors";
import { HEARTH_CANONICAL } from "@/lib/hearth/site";
import { fetchHearthVersion } from "@/lib/hearth/version";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

// Hearth gets its own card rather than the site's generic one: the product is
// its colors, so the card shows the theme highlighting real code.
const HEARTH_OG_IMAGE = "/hearth/og.png";

const {
  title = "Hearth — A warm theme for VS Code, Cursor, and more",
  description = "Hearth keeps the interface calm and lights the code with a single ember. Six light and dark variants for VS Code, Cursor, Zed, Warp, and Shiki.",
  ogImage = HEARTH_OG_IMAGE,
} = Astro.props;

const SITE = "https://www.ryanfurrer.com";
const currentYear = new Date().getFullYear();
const version = await fetchHearthVersion();

const externalRel = "noopener noreferrer";
---

<html lang="en">
  {
    /* The subdomain serves only its root, so a second Hearth page would need
      middleware.ts widened before it could claim a canonical of its own. */
  }
  <Head
    title={title}
    description={description}
    ogImage={ogImage}
    canonical={HEARTH_CANONICAL}
  />
  <body class="bg-background text-subtle-foreground antialiased">
    <a
      href="#main-content"
      class="focus:inset-block-start-4 focus:inset-inline-start-4 sr-only focus:not-sr-only focus:fixed focus:z-50 focus:rounded-md focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
    >
      Skip to content
    </a>

    <header
      data-site-header
      class="group sticky top-0 z-40 border-b border-transparent transition-[border-color,translate] duration-300 ease-out data-hidden:-translate-y-full data-scrolled:border-border"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 transform-[translateZ(0)] bg-background/70 opacity-0 backdrop-blur-xl transition-opacity duration-300 ease-out will-change-transform group-data-scrolled:opacity-100"
      >
      </div>
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 text-foreground"
          aria-label="Hearth home"
        >
          <HearthMark class="size-6" />
          <span class="font-semibold tracking-tight">Hearth</span>
        </a>

        <nav aria-label="Site" class="flex items-center gap-4 sm:gap-5">
          <a
            href={SITE}
            target="_blank"
            rel={externalRel}
            class="quiet-link hidden text-sm sm:inline">ryanfurrer.com</a
          >
          <a
            href={GITHUB_URL}
            target="_blank"
            rel={externalRel}
            class="quiet-link hidden text-sm sm:inline">GitHub</a
          >
          <ModeToggle client:idle />
          {
            /* Bare "Install" must not presume an editor — it goes to the picker
              section; only CTAs naming VS Code link straight to the Marketplace. */
          }
          <a href="/#install" class={buttonVariants({ size: "sm" })}>Install</a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto max-w-5xl space-y-8 px-6 py-12">
        <div
          class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-center gap-2.5">
            <HearthMark class="size-6" />
            <div>
              <p class="flex items-baseline gap-2 font-medium text-foreground">
                Hearth
                {
                  version && (
                    <a
                      href={version.href}
                      target="_blank"
                      rel={externalRel}
                      class="quiet-link font-mono text-xs font-normal"
                    >
                      v{version.version}
                    </a>
                  )
                }
              </p>
              <p class="text-sm text-subtle-foreground">
                A warm color theme by
                {" "}<a
                  href={SITE}
                  target="_blank"
                  rel={externalRel}
                  class="quiet-link"
                >
                  Ryan Furrer
                </a>.
              </p>
            </div>
          </div>
          <nav
            aria-label="Footer"
            class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm"
          >
            <a
              href={MARKETPLACE_URL}
              target="_blank"
              rel={externalRel}
              class="quiet-link"
            >
              Marketplace
            </a>
            <a
              href={GITHUB_URL}
              target="_blank"
              rel={externalRel}
              class="quiet-link"
            >
              GitHub
            </a>
            <a href={SITE} target="_blank" rel={externalRel} class="quiet-link">
              ryanfurrer.com
            </a>
          </nav>
        </div>
        <div
          class="flex items-center justify-between text-sm text-subtle-foreground"
        >
          <p>&copy; {currentYear} Ryan Furrer</p>
          <ModeToggle client:idle />
        </div>
      </div>
    </footer>

    <Analytics />
    <SpeedInsights />
    <script>
      import "@/scripts/sticky-header";
      import "@/scripts/reveal";
    </script>
  </body>
</html>
