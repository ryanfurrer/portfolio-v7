---
/**
 * Callout — a labelled, colour-coded aside for posts and anywhere on the site.
 *
 * Props-driven so it works standalone (`<Callout variant="warning">…</Callout>`);
 * a thin Portable Text wrapper (CalloutBlock.astro) will feed it Sanity data.
 * Body is a slot so it inherits the site's link/emphasis styling.
 *
 * Icons are inline lucide paths (crisp + themeable, aria-hidden). Caution uses
 * rose rather than pure red so it stays distinct from the destructive/error red;
 * info uses azure (Tailwind sky) — the conventional informational hue.
 *
 * Each variant's accent doubles as `--callout-accent` (light-dark, resolved by
 * the theme's color-scheme) so body links can pick up the tint — the actual
 * link rule lives in unlayered.css, where it can beat the site-wide link reset.
 */
type Variant = "info" | "warning" | "caution";

interface Props {
  variant?: Variant;
  /** Override the default label for this variant. */
  title?: string;
}

const { variant = "info", title }: Props = Astro.props;

const VARIANTS: Record<
  Variant,
  { label: string; surface: string; accent: string; icon: string }
> = {
  info: {
    label: "Note",
    surface:
      "bg-sky-50 border-sky-300/80 dark:bg-sky-950/40 dark:border-sky-900/60",
    accent:
      "[--callout-accent:light-dark(var(--color-sky-700),var(--color-sky-300))]",
    // lucide: info
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  },
  warning: {
    label: "Warning",
    surface:
      "bg-amber-50 border-amber-300/80 dark:bg-amber-950/40 dark:border-amber-900/60",
    accent:
      "[--callout-accent:light-dark(var(--color-amber-700),var(--color-amber-300))]",
    // lucide: triangle-alert
    icon: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  },
  caution: {
    label: "Caution",
    surface:
      "bg-rose-50 border-rose-300/80 dark:bg-rose-950/40 dark:border-rose-900/60",
    accent:
      "[--callout-accent:light-dark(var(--color-rose-700),var(--color-rose-300))]",
    // lucide: octagon-alert
    icon: '<path d="M12 16h.01"/><path d="M12 8v4"/><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"/>',
  },
};

// Existing documents can retain a removed variant until their next edit. Render
// them as Notes rather than failing while content is being migrated.
const resolvedVariant = variant in VARIANTS ? variant : "info";
const { label, surface, accent, icon } = VARIANTS[resolvedVariant];
const heading = title ?? label;
---

<aside
  role="note"
  class:list={[
    "my-6 rounded-lg border p-4 text-pretty shadow-sm dark:shadow-none",
    surface,
    accent,
  ]}
>
  <div class="flex items-center gap-2 text-(--callout-accent)">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0"
      aria-hidden="true"
      set:html={icon}
    />
    <span class="font-medium tracking-tight text-balance">{heading}</span>
  </div>
  <div
    class="callout-body mt-1.5 text-base/6 text-pretty text-foreground [&_p]:m-0 [&_p+p]:mt-2"
  >
    <slot />
  </div>
</aside>
