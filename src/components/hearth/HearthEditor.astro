---
import { Code } from "astro:components";
import { cn } from "@/lib/utils";
import { segmentedItem } from "@/lib/segmented";
import { DEFAULT_FLAVOR, EDITOR_SAMPLE, FLAVORS } from "@/lib/hearth/flavors";

// Shiki's ThemeRegistrationRaw type marks `settings` as required, but the runtime
// consumes VS Code `tokenColors`; the vendored Hearth JSON is valid at load. The
// cast bridges that gap (mirrors CodeBlock.astro).
const asTheme = (themes: { light: unknown; dark: unknown }) => themes as never;
---

<figure
  class="hearth-editor not-prose overflow-hidden rounded-xl border border-border bg-card shadow-elevated"
  data-hearth-editor
  data-flavor={DEFAULT_FLAVOR}
>
  <div
    class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-border px-4 py-3"
  >
    <span class="flex items-center gap-1.5" aria-hidden="true">
      <span class="size-3 rounded-full bg-foreground/15"></span>
      <span class="size-3 rounded-full bg-foreground/15"></span>
      <span class="size-3 rounded-full bg-foreground/15"></span>
    </span>
    <span class="font-mono-custom text-xs text-subtle-foreground">hearth.ts</span
    >

    <div
      class="ms-auto flex items-center gap-0.5 rounded-lg bg-muted p-1"
      role="radiogroup"
      aria-label="Theme flavor"
    >
      {
        FLAVORS.map((flavor) => {
          const active = flavor.id === DEFAULT_FLAVOR;
          return (
            <button
              type="button"
              role="radio"
              aria-checked={active ? "true" : "false"}
              tabindex={active ? 0 : -1}
              data-flavor-btn={flavor.id}
              class={cn(segmentedItem({ active }), "flex items-center gap-1.5")}
            >
              <span
                class="size-2 rounded-full"
                style={`background-color: ${flavor.accent.light}`}
                data-accent-light={flavor.accent.light}
                data-accent-dark={flavor.accent.dark}
                aria-hidden="true"
              />
              {flavor.name}
            </button>
          );
        })
      }
    </div>

    <button
      type="button"
      class="hearth-copy grid size-8 place-items-center rounded-md text-subtle-foreground transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      data-code={EDITOR_SAMPLE}
      aria-label="Copy code"
    >
      <svg
        class="hearth-copy-icon hearth-copy-icon--copy size-4"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
        <path
          d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"
        ></path>
      </svg>
      <svg
        class="hearth-copy-icon hearth-copy-icon--check size-4 text-brand"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3.5 8.5 6.5 11.5 12.5 5"></path>
      </svg>
    </button>
  </div>

  <div class="hearth-canvas">
    {
      FLAVORS.map((flavor) => (
        <div
          class="hearth-panel"
          data-flavor={flavor.id}
          hidden={flavor.id !== DEFAULT_FLAVOR}
        >
          <Code
            code={EDITOR_SAMPLE}
            lang="ts"
            themes={asTheme(flavor.themes)}
            wrap={true}
          />
        </div>
      ))
    }
    <span class="sr-only" role="status" aria-live="polite"></span>
  </div>
</figure>

<style>
  /* The chrome is site UI; the canvas is the theme's real editor surface. Light
     ships inline on the <pre>; dark rides --shiki-dark-bg, swapped in under
     .dark (the token color swap itself lives in the global prose rule). */
  .hearth-editor :global(.astro-code) {
    margin: 0;
    padding: 1.25rem 1.25rem 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  :global(.dark) .hearth-editor :global(.astro-code) {
    background-color: var(--shiki-dark-bg) !important;
  }

  .hearth-copy {
    position: relative;
  }
  .hearth-copy-icon {
    grid-area: 1 / 1;
    transition: opacity 150ms var(--ease-out-curve);
  }
  .hearth-copy-icon--check {
    opacity: 0;
  }
  .hearth-copy[data-copied] .hearth-copy-icon--copy {
    opacity: 0;
  }
  .hearth-copy[data-copied] .hearth-copy-icon--check {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-copy-icon {
      transition: none;
    }
  }
</style>

<script>
  const RESET_MS = 1100;

  for (const editor of document.querySelectorAll<HTMLElement>(
    "[data-hearth-editor]",
  )) {
    const radios = [
      ...editor.querySelectorAll<HTMLButtonElement>("[data-flavor-btn]"),
    ];
    const panels = editor.querySelectorAll<HTMLElement>(".hearth-panel");
    const dark = () => document.documentElement.classList.contains("dark");

    const paintDots = () => {
      for (const dot of editor.querySelectorAll<HTMLElement>(
        "[data-accent-light]",
      )) {
        dot.style.backgroundColor = dark()
          ? (dot.dataset.accentDark ?? "")
          : (dot.dataset.accentLight ?? "");
      }
    };

    const select = (id: string, focus = false) => {
      editor.dataset.flavor = id;
      for (const radio of radios) {
        const active = radio.dataset.flavorBtn === id;
        radio.setAttribute("aria-checked", active ? "true" : "false");
        radio.tabIndex = active ? 0 : -1;
        // Mirror segmentedItem()'s boxed active/idle classes.
        radio.classList.toggle("bg-foreground/10", active);
        radio.classList.toggle("text-foreground", active);
        radio.classList.toggle("text-subtle-foreground", !active);
        if (active && focus) radio.focus();
      }
      for (const panel of panels)
        panel.hidden = panel.dataset.flavor !== id;
    };

    radios.forEach((radio, index) => {
      radio.addEventListener("click", () =>
        select(radio.dataset.flavorBtn ?? "", false),
      );
      radio.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" || event.key === "ArrowDown"
            ? 1
            : event.key === "ArrowLeft" || event.key === "ArrowUp"
              ? -1
              : 0;
        if (!step) return;
        event.preventDefault();
        const next = radios[(index + step + radios.length) % radios.length];
        select(next.dataset.flavorBtn ?? "", true);
      });
    });

    // Keep the accent dots in sync when the site theme flips.
    paintDots();
    new MutationObserver(paintDots).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });

    const copyBtn = editor.querySelector<HTMLButtonElement>(".hearth-copy");
    const status = editor.querySelector<HTMLElement>('[role="status"]');
    let timer = 0;
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.code ?? "");
        copyBtn.dataset.copied = "true";
        copyBtn.setAttribute("aria-label", "Copied");
        if (status) status.textContent = "Copied to clipboard";
      } catch {
        copyBtn.setAttribute("aria-label", "Copy failed");
        if (status) status.textContent = "Copy failed";
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete copyBtn.dataset.copied;
        copyBtn.setAttribute("aria-label", "Copy code");
        if (status) status.textContent = "";
      }, RESET_MS);
    });
  }
</script>
