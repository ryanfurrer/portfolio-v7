---
import { sanityClient } from "sanity:client";
import LatestItemsSection from "@/components/LatestItemsSection.astro";
import CtaLink from "@/components/CtaLink.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import Layout from "@/layouts/Layout.astro";
import { socialLinks } from "@/lib/social-links";
import { SITE_DESCRIPTION } from "@/consts";
import { LATEST_ITEMS_QUERY } from "@/sanity/lib/queries";
import type { LATEST_ITEMS_QUERY_RESULT } from "@/sanity/sanity.types";

const latestItems =
  await sanityClient.fetch<LATEST_ITEMS_QUERY_RESULT>(LATEST_ITEMS_QUERY);

// Person entity for the site — links the profile to every social account so
// search engines can associate them (knowledge-panel eligibility).
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ryan Furrer",
  url: Astro.site?.toString(),
  jobTitle: "Frontend Engineer and Designer",
  description: SITE_DESCRIPTION,
  image: new URL("/og-image.png", Astro.site).toString(),
  sameAs: socialLinks.map((link) => link.href),
};
---

<Layout jsonLd={personJsonLd}>
  <main class="space-y-16">
    <section class="space-y-6">
      <div class="space-y-3" data-reveal>
        <h1 class="text-3xl text-foreground sm:text-4xl">Ryan Furrer</h1>
        <p class="lead max-w-[46ch]">
          I feel at home where design and engineering meet.<br />
          Crafting interfaces down to the last detail.
        </p>
      </div>
      <div class="max-w-[46ch] space-y-3 text-pretty" data-reveal>
        <p>
          Currently I am a Frontend Engineer and Designer at <a
            href="https://pragma.gg"
            >Pragma</a
          >, part of the team creating the platform that helps studios build
          successful games, <a href="https://firstlook.gg">FirstLook</a>.
        </p>
        <CtaLink href="/about">Learn more about me</CtaLink>
      </div>

      <div class="space-y-2" data-reveal>
        <span class="small-heading inline-block">Find me elsewhere:</span>
        <div class="text-sm">
          <SocialLinks orientation="horizontal" />
        </div>
      </div>
    </section>
    <LatestItemsSection title="Latest" items={latestItems} />
  </main>
</Layout>
