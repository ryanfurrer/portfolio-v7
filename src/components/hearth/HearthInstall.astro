---
import { Code } from "astro:components";
import HearthCodeWindow from "./HearthCodeWindow.astro";
import HearthTabs from "./HearthTabs.astro";
import {
  CLI_INSTALL,
  CURSOR_DEEP_LINK,
  DEFAULT_FLAVOR,
  FLAVORS,
  GITHUB_URL,
  MARKETPLACE_URL,
  OPEN_VSX_URL,
  VSIX_URL,
  VSCODE_DEEP_LINK,
} from "@/lib/hearth/flavors";

const THEMES_URL = `${GITHUB_URL}/tree/main/themes`;
const ZED_THEME_URL = `${GITHUB_URL}/blob/main/zed/themes/hearth.json`;
const WARP_THEMES_URL = `${GITHUB_URL}/tree/main/warp`;
const GHOSTTY_THEMES_URL = `${GITHUB_URL}/tree/main/ghostty`;
const hearthThemes = FLAVORS.find(({ id }) => id === DEFAULT_FLAVOR)?.themes;

if (!hearthThemes) throw new Error("The default Hearth theme is missing");

const SHIKI_FILE = "highlight.ts";
const SHIKI_SAMPLE = `import { codeToHtml } from "shiki";
import hearthDark from "./hearth-dark.json";

const html = await codeToHtml(code, {
  lang: "ts",
  theme: hearthDark,
});
`;

const tabs = [
  { id: "vscode", label: "VS Code" },
  { id: "cursor", label: "Cursor" },
  { id: "zed", label: "Zed" },
  { id: "warp", label: "Warp" },
  { id: "ghostty", label: "Ghostty" },
  { id: "shiki", label: "Shiki" },
];
---

<HearthTabs
  tabs={tabs}
  label="Install Hearth in"
  idPrefix="hearth"
  param="install"
>
  <div
    id="hearth-panel-vscode"
    role="tabpanel"
    aria-labelledby="hearth-tab-vscode"
    tabindex="0"
    class="hearth-panel"
  >
    <ol class="hearth-steps">
      <li>
        Install from the terminal — or search <strong>Hearth</strong> in the Extensions
        panel and click Install.
        <button
          type="button"
          class="hearth-cmd group"
          data-copy={CLI_INSTALL}
          aria-label={`Copy install command: ${CLI_INSTALL}`}
        >
          <span class="hearth-cmd-prompt" aria-hidden="true">$</span>
          <code class="hearth-cmd-text">{CLI_INSTALL}</code>
          <span class="hearth-cmd-hint" aria-hidden="true">Copy</span>
        </button>
      </li>
      <li>
        Open the theme picker with <kbd class="hearth-kbd">⌘K</kbd>
        {" "}<kbd class="hearth-kbd">⌘T</kbd> (Ctrl on Windows and Linux) and choose
        a Hearth.
      </li>
    </ol>
    <div class="hearth-panel-links">
      <a href={VSCODE_DEEP_LINK} class="hearth-panel-link"> Open in VS Code </a>
      <a
        href={MARKETPLACE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hearth-panel-link"
      >
        View Marketplace
      </a>
    </div>
  </div>

  <div
    id="hearth-panel-cursor"
    role="tabpanel"
    aria-labelledby="hearth-tab-cursor"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        In Cursor, open the Extensions panel, search <strong>Hearth</strong>,
        and click <strong>Install</strong>.
      </li>
      <li>
        You can also find Hearth on <a
          href={OPEN_VSX_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link">Open VSX</a
        >.
      </li>
      <li>
        To sideload instead, <a
          href={VSIX_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link"
          >download <code class="hearth-inline-code">hearth-latest.vsix</code
          ></a
        >, then choose <strong>Install from VSIX…</strong> from the Extensions panel's
        {" "}<strong>⋯</strong> menu.
      </li>
      <li>
        Open the theme picker with <kbd class="hearth-kbd">⌘K</kbd>
        {" "}<kbd class="hearth-kbd">⌘T</kbd> (Ctrl on Windows and Linux) and choose
        a Hearth.
      </li>
    </ol>
    <div class="hearth-panel-links">
      <a href={CURSOR_DEEP_LINK} class="hearth-panel-link"> Open in Cursor </a>
      <a
        href={OPEN_VSX_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hearth-panel-link"
      >
        View on Open VSX
      </a>
    </div>
  </div>

  <div
    id="hearth-panel-zed"
    role="tabpanel"
    aria-labelledby="hearth-tab-zed"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        Download <a
          href={ZED_THEME_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link">hearth.json</a
        > — one file carrying all six variants.
      </li>
      <li>
        Move it into Zed's themes folder,
        {" "}<code class="hearth-inline-code">~/.config/zed/themes/</code> on macOS
        and Linux.
      </li>
      <li>Pick a Hearth from Zed's theme selector.</li>
    </ol>
    <p class="hearth-note">
      The repo's <code class="hearth-inline-code">zed/</code> folder also installs
      with <code class="hearth-inline-code">zed: install dev extension</code>.
      An extension-store listing is planned.
    </p>
  </div>

  <div
    id="hearth-panel-warp"
    role="tabpanel"
    aria-labelledby="hearth-tab-warp"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        Download the light and dark themes from the repo's <a
          href={WARP_THEMES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link">warp folder</a
        >.
      </li>
      <li>
        Move them into
        {" "}<code class="hearth-inline-code">~/.warp/themes/hearth/</code>.
      </li>
      <li>
        Restart Warp if the themes don't show up, then pick a Hearth from the
        theme picker.
      </li>
    </ol>
    <p class="hearth-note">
      Warp doesn't expose editor syntax scopes, so Hearth ships one complete
      ANSI palette in light and dark. A listing in Warp's own theme repo is in
      review.
    </p>
  </div>

  <div
    id="hearth-panel-ghostty"
    role="tabpanel"
    aria-labelledby="hearth-tab-ghostty"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        Download the light and dark themes from the repo's <a
          href={GHOSTTY_THEMES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link">ghostty folder</a
        >.
      </li>
      <li>
        Move them into
        {" "}<code class="hearth-inline-code">~/.config/ghostty/themes/</code>.
      </li>
      <li>
        Add <code class="hearth-inline-code">theme = hearth-dark</code> (or
        {" "}<code class="hearth-inline-code">hearth-light</code>) to your
        {" "}<code class="hearth-inline-code">~/.config/ghostty/config</code>,
        then reload with <kbd class="hearth-kbd">⌘</kbd>
        {" "}<kbd class="hearth-kbd">⇧</kbd> <kbd class="hearth-kbd">,</kbd> (Ctrl
        on Linux).
      </li>
    </ol>
    <p class="hearth-note">
      To follow your system appearance automatically, pair both variants:
      {" "}<code class="hearth-inline-code"
        >theme = dark:hearth-dark,light:hearth-light</code
      >.
    </p>
  </div>

  <div
    id="hearth-panel-shiki"
    role="tabpanel"
    aria-labelledby="hearth-tab-shiki"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        Grab any of the six theme files from the <a
          href={THEMES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link">themes folder</a
        > — they're plain VS Code theme JSON.
      </li>
      <li>
        Pass one to Shiki as a <code class="hearth-inline-code">theme</code>:
      </li>
    </ol>
    <HearthCodeWindow class="hearth-shiki-code not-prose" file={SHIKI_FILE}>
      <Code code={SHIKI_SAMPLE} lang="ts" themes={hearthThemes as never} />
    </HearthCodeWindow>
  </div>
</HearthTabs>

<style>
  .hearth-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .hearth-panel:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  .hearth-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    counter-reset: step;
    max-width: 42rem;
  }
  .hearth-steps > li {
    position: relative;
    padding-inline-start: 2.25rem;
    color: var(--subtle-foreground);
    text-wrap: pretty;
  }
  .hearth-steps > li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: -0.1rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--brand);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .hearth-steps strong {
    font-weight: 500;
    color: var(--foreground);
  }

  .hearth-inline-link {
    text-underline-offset: 3px;
  }
  .hearth-inline-code {
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .hearth-note {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .hearth-panel-link {
    font-size: 0.9375rem;
    text-underline-offset: 3px;
  }
  .hearth-panel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .hearth-shiki-code {
    width: 100%;
    max-width: 42rem;
  }

  .hearth-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.05rem 0.35rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .hearth-cmd {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-block-start: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-lg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    cursor: pointer;
    transition: translate 150ms var(--ease-out-curve);
  }
  .hearth-cmd:active {
    translate: 0 1px;
  }
  .hearth-cmd:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .hearth-cmd-prompt {
    color: var(--brand);
  }
  .hearth-cmd-hint {
    margin-inline-start: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--subtle-foreground);
  }
  .hearth-cmd.is-copied .hearth-cmd-hint {
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-cmd {
      transition: none;
    }
  }
</style>

<script>
  const status = document.createElement("span");
  status.className = "sr-only";
  status.setAttribute("role", "status");
  status.setAttribute("aria-live", "polite");
  document.body.appendChild(status);

  for (const cmd of document.querySelectorAll<HTMLButtonElement>(
    ".hearth-cmd",
  )) {
    const hint = cmd.querySelector<HTMLElement>(".hearth-cmd-hint");
    let timer = 0;
    cmd.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmd.dataset.copy ?? "");
        cmd.classList.add("is-copied");
        if (hint) hint.textContent = "Copied";
        status.textContent = "Command copied to clipboard";
      } catch {
        status.textContent = "Copy failed";
        return;
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        cmd.classList.remove("is-copied");
        if (hint) hint.textContent = "Copy";
        status.textContent = "";
      }, 1100);
    });
  }
</script>
