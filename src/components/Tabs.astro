---
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  /** Accessible name for the tablist. */
  label: string;
  /** Tab id to show first; defaults to the first tab. */
  initial?: string;
}

const { tabs, label, initial } = Astro.props;
const active = initial ?? tabs[0]?.id;
---

<div data-tabs>
  <div
    role="tablist"
    aria-label={label}
    class="inline-flex gap-1 rounded-lg bg-surface p-1 [box-shadow:inset_0_0_0_1px_var(--border)]"
  >
    {
      tabs.map((t) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          data-tab={t.id}
          aria-controls={`panel-${t.id}`}
          aria-selected={t.id === active ? "true" : "false"}
          tabindex={t.id === active ? 0 : -1}
          class="rounded-md px-4 py-1.5 text-sm font-medium text-body transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring aria-selected:bg-foreground aria-selected:text-primary-foreground aria-selected:hover:text-primary-foreground"
        >
          {t.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((t) => (
      <div
        role="tabpanel"
        id={`panel-${t.id}`}
        data-panel={t.id}
        aria-labelledby={`tab-${t.id}`}
        hidden={t.id !== active}
        class="mt-8 focus-visible:outline-none"
      >
        <slot name={t.id} />
      </div>
    ))
  }
</div>

<script>
  // Accessible tabs (WAI-ARIA APG): roving tabindex, Left/Right/Home/End keys,
  // click to select. Panels toggle via `hidden` so both stay in the DOM — Astro
  // component scripts inside a panel keep working even while it's inactive.
  // Emits a bubbling `tabchange` CustomEvent so a host page can sync side UI.
  function initTabs(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
      if (p.dataset.panel) panels.set(p.dataset.panel, p);
    });

    function select(id: string, focusTab = true) {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      });
      panels.forEach((panel, pid) => (panel.hidden = pid !== id));
      root.dispatchEvent(
        new CustomEvent("tabchange", { detail: { active: id }, bubbles: true }),
      );
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.dataset.tab!, false));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === "ArrowRight") next = i === last ? 0 : i + 1;
        else if (e.key === "ArrowLeft") next = i === 0 ? last : i - 1;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = last;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next].dataset.tab!);
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(initTabs);
</script>
