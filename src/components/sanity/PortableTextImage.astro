---
import {
  imageDimensions,
  urlForImage,
  zoomImageUrl,
} from "@/sanity/lib/url-for-image";

const { asset, alt } = Astro.props.node;

// A Portable Text image block can exist before its asset is uploaded (e.g. while
// editing a draft in the Studio with preview on), leaving `asset` undefined.
// Guard so draft preview doesn't crash trying to resolve a URL from `undefined`.
const url = asset ? urlForImage(asset).url() : null;
const webpUrl = asset ? urlForImage(asset).format("webp").url() : null;
// Enlarged variant, requested only when the reader opens the lightbox.
const zoomUrl = asset ? zoomImageUrl(asset) : null;
// Intrinsic size (parsed from the asset ref) reserves layout space so body
// images don't shift the article as they decode.
const size = imageDimensions(asset);
---

{
  url && (
    <button
      type="button"
      class="zoomable-image"
      data-zoom-src={zoomUrl}
      data-zoom-alt={alt ?? ""}
      aria-label={alt ? `Enlarge image: ${alt}` : "Enlarge image"}
    >
      <picture>
        <source srcset={webpUrl} type="image/webp" />
        <img
          src={url}
          alt={alt}
          width={size?.width}
          height={size?.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </button>
  )
}
