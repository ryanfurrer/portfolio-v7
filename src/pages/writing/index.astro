---
import { sanityClient } from "sanity:client";
import Container from "@/components/Container.astro";
import Item from "@/components/Item.astro";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getUnpublishedDocumentIds, groupByYear } from "@/sanity/lib/content";
import { POSTS_QUERY } from "@/sanity/lib/queries";
import type { POSTS_QUERY_RESULT } from "@/sanity/sanity.types";
import { SECTION_META } from "@/lib/og/sections";

const posts = await sanityClient.fetch<POSTS_QUERY_RESULT>(POSTS_QUERY);
const unpublishedIds = await getUnpublishedDocumentIds(sanityClient, posts);
const { byYear: postsByYear, years } = groupByYear(posts);

const description = SECTION_META.writing.description;
---

<Layout
  title="Writing — Ryan Furrer"
  description={description}
  ogImage="/og/writing.png"
>
  <div class="space-y-8">
    <PageHeader title="Writing" lead={description} />
    <main>
      <Container class="space-y-8">
        {
          years.map((year) => (
            <section class="space-y-4">
              <h2 class="small-heading text-box-trim-start" data-reveal>
                {year}
              </h2>
              <ul class="flex flex-col gap-px" role="list">
                {postsByYear[year].map((post) => (
                  <li>
                    <Item
                      title={post.title}
                      href={`/writing/${post.slug?.current}`}
                      publishedAt={post.publishedAt}
                      unpublished={unpublishedIds.has(post._id)}
                    />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </Container>
    </main>
  </div>
</Layout>
