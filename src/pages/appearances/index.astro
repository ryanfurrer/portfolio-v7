---
import { sanityClient } from "sanity:client";
import Container from "@/components/Container.astro";
import Item from "@/components/Item.astro";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getUnpublishedDocumentIds, groupByYear } from "@/sanity/lib/content";
import { APPEARANCES_QUERY } from "@/sanity/lib/queries";
import type { APPEARANCES_QUERY_RESULT } from "@/sanity/sanity.types";
import { SECTION_META } from "@/lib/og/sections";

const appearances =
  await sanityClient.fetch<APPEARANCES_QUERY_RESULT>(APPEARANCES_QUERY);
const unpublishedIds = await getUnpublishedDocumentIds(
  sanityClient,
  appearances,
);
const { byYear: appearancesByYear, years } = groupByYear(appearances);

const description = SECTION_META.appearances.description;
---

<Layout
  title="Appearances — Ryan Furrer"
  description={description}
  ogImage="/og/appearances.png"
>
  <div class="space-y-8">
    <PageHeader title="Appearances" lead={description} />
    <main>
      <Container class="space-y-8">
        {
          years.map((year) => (
            <section class="space-y-4">
              <h2 class="small-heading text-box-trim-start" data-reveal>
                {year}
              </h2>
              <ul class="flex flex-col gap-px" role="list">
                {appearancesByYear[year].map((appearance) => (
                  <li>
                    <Item
                      title={appearance.title}
                      href={`/appearances/${appearance.slug?.current}`}
                      publishedAt={appearance.publishedAt}
                      unpublished={unpublishedIds.has(appearance._id)}
                    />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </Container>
    </main>
  </div>
</Layout>
