---
import { Font } from "astro:assets";
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from "@/consts";
import { THEME_COLORS } from "@/lib/theme-colors";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  /** schema.org structured data, rendered as a JSON-LD script. */
  jsonLd?: Record<string, unknown>;
  /**
   * Absolute URL to claim as this page's address, for both the canonical link
   * and og:url. Only needed when a page is served from a host other than
   * `site` — otherwise the URL is derived and these stay in step.
   */
  canonical?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
  ogType = "website",
  publishedTime,
  modifiedTime,
  jsonLd,
  canonical,
} = Astro.props;

const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const defaultOgImage = new URL("/og-image.png", Astro.site).toString();
const ogImageUrl = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : new URL(ogImage, Astro.site).toString()
  : defaultOgImage;

const lightThemeColor = THEME_COLORS.light;
const darkThemeColor = THEME_COLORS.dark;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  {
    /* Match --background exactly so mobile browser chrome doesn't seam against
      the page. Both the pre-paint and runtime paths share these values. */
  }
  <meta name="theme-color" content={lightThemeColor} />
  {
    /* Resolve the saved theme choice (or fall back to the OS preference) and
      apply the .dark class to <html> before first paint — no flash of the
      wrong theme. Also syncs the browser-chrome color. The theme controls keep
      both in step at runtime. Mirrors the resolution in @/lib/theme. */
  }
  <script is:inline define:vars={{ lightThemeColor, darkThemeColor }}>
    (() => {
      try {
        const stored = localStorage.getItem("theme");
        const dark =
          stored === "dark" ||
          (stored !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta)
          meta.setAttribute("content", dark ? darkThemeColor : lightThemeColor);
      } catch {}
    })();
  </script>
  {
    /* Arm the entrance reveal before paint so [data-reveal] content starts
      hidden — but only when JS is on and motion is allowed. See
      scripts/reveal.ts. */
  }
  <script is:inline>
    (() => {
      try {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.documentElement.classList.add("reveal-init");
      } catch {}
    })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {
    /* Body sans — Google Sans via the Astro font provider (see astro.config
      `fonts`). Emits @font-face + preload for whatever --font-sans points at. */
  }
  <Font cssVariable="--font-google-sans" preload />
  <link
    rel="preload"
    href="/assets/fonts/BerkeleyMono-Regular.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/assets/fonts/PermanentMarker-Regular.ttf"
    as="font"
    type="font/ttf"
    crossorigin
  />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="canonical" href={pageUrl} />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  {
    ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )
  }
  {
    ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )
  }
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={title} />
  {
    jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
      />
    )
  }
</head>
