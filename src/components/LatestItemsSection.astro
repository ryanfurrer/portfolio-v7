---
import Item from "./Item.astro";

interface LatestItem {
  _id: string;
  _type: "post" | "project" | "appearance";
  title: string | null;
  slug: { current?: string } | null;
}

interface Props {
  title: string;
  items: LatestItem[];
}

const { title, items } = Astro.props;

const categoryByType: Record<LatestItem["_type"], string> = {
  post: "Writing",
  project: "Work",
  appearance: "Appearances",
};

const basePathByType: Record<LatestItem["_type"], string> = {
  post: "/writing",
  project: "/work",
  appearance: "/appearances",
};
---

<section class="space-y-2">
  <h2 class="small-heading" data-reveal>
    {title}
  </h2>
  <ul class="flex flex-col gap-px" role="list">
    {
      items.map((item) => (
        <li>
          <Item
            title={item.title}
            href={`${basePathByType[item._type]}/${item.slug?.current}`}
          >
            <p
              slot="trailing"
              class="small-heading transition-colors can-hover:group-hover/item:text-foreground"
            >
              {categoryByType[item._type]}
            </p>
          </Item>
        </li>
      ))
    }
  </ul>
</section>
