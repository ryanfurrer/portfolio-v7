<style>
  /* Live token values — filled from the cascade so light/dark always match. */
  [data-token] {
    text-transform: none;
  }

  /* Motion demo — the dot slides to the far edge on section hover, each row
     using one of the system's two curves so the settle is directly comparable.
     margin-inline-start keeps it logical + RTL-safe. Reduced-motion users get a
     jump (the global reduce rule excludes margin from its transition allow-list). */
  .motion-dot {
    margin-inline-start: 0;
    transition-property: margin-inline-start;
    transition-duration: 700ms;
  }
  .motion-dot--0 {
    transition-timing-function: var(--ease-out);
  }
  .motion-dot--1 {
    transition-timing-function: var(--ease-ios);
  }
  .motion-demo:hover .motion-dot {
    margin-inline-start: calc(100% - 1.5rem);
  }
</style>

<script>
  // Fill every [data-token] with its resolved custom-property value, and re-read
  // when the theme class flips on <html> so the numbers track light/dark.
  function refreshTokens() {
    const styles = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>("[data-token]").forEach((el) => {
      const name = el.dataset.token;
      if (!name) return;
      el.textContent = styles.getPropertyValue(name).trim() || "—";
    });
  }

  refreshTokens();
  new MutationObserver(refreshTokens).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>
