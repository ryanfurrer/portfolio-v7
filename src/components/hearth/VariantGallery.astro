---
import { Code } from "astro:components";
import { FLAVORS, GALLERY_SAMPLE } from "@/lib/hearth/flavors";

const modes = [
  { key: "light", label: "Light" },
  { key: "dark", label: "Dark" },
] as const;

// Shiki's ThemeRegistrationRaw type marks `settings` as required, but the runtime
// consumes VS Code `tokenColors`; the vendored Hearth JSON is valid at load. The
// cast bridges that gap (mirrors CodeBlock.astro).
const asTheme = (themes: { light: unknown; dark: unknown }) => themes as never;
---

<div class="hearth-gallery space-y-10">
  {
    FLAVORS.map((flavor) => (
      <div class="space-y-4" data-reveal>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="flex items-center gap-2 text-lg font-medium text-foreground">
            <span
              class="size-2.5 rounded-full"
              style={`background-color: ${flavor.accent.dark}`}
              aria-hidden="true"
            />
            {flavor.fullName}
          </h3>
          <p class="text-sm text-muted-foreground">{flavor.tagline}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {modes.map((mode) => (
            <figure class="space-y-2">
              <div class="hearth-variant" data-mode={mode.key}>
                <Code
                  code={GALLERY_SAMPLE}
                  lang="ts"
                  themes={asTheme(flavor.themes)}
                  defaultColor={false}
                  data-shiki-pin={mode.key}
                  wrap={true}
                />
              </div>
              <figcaption class="text-xs text-subtle-foreground">
                {mode.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  /* An outset ring, not inset: the code <pre> fills the card edge-to-edge, so an
     inset shadow paints under it and vanishes. --border is translucent, so one
     ring reads on any card against any page. */
  .hearth-variant {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--border);
  }
  .hearth-variant :global(.astro-code) {
    margin: 0;
    padding: 1rem 1.125rem;
    font-size: 0.75rem;
    line-height: 1.65;
  }

  /* Cards share the editor's three dual-theme highlighters rather than minting a
     single-theme one each: `defaultColor={false}` leaves both sides on
     --shiki-light/--shiki-dark and each card pins itself to one. data-shiki-pin
     also opts the card out of the global .dark swap in prose.css, so it holds
     its theme whatever mode the page is in. */
  .hearth-variant :global([data-shiki-pin="light"]) {
    background-color: var(--shiki-light-bg);
  }
  .hearth-variant :global([data-shiki-pin="light"]),
  .hearth-variant :global([data-shiki-pin="light"] span) {
    color: var(--shiki-light);
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
    text-decoration: var(--shiki-light-text-decoration);
  }
  .hearth-variant :global([data-shiki-pin="dark"]) {
    background-color: var(--shiki-dark-bg);
  }
  .hearth-variant :global([data-shiki-pin="dark"]),
  .hearth-variant :global([data-shiki-pin="dark"] span) {
    color: var(--shiki-dark);
    font-style: var(--shiki-dark-font-style);
    font-weight: var(--shiki-dark-font-weight);
    text-decoration: var(--shiki-dark-text-decoration);
  }
</style>
