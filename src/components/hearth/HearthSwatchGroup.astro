---
import type { PaletteRow } from "@/lib/hearth/flavors";

interface Props {
  heading: string;
  rows: PaletteRow[];
}

const { heading, rows } = Astro.props;
---

<div class="space-y-4">
  <div
    class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4"
    data-reveal
  >
    <h3 class="small-heading">{heading}</h3>
    <span class="flex gap-2" aria-hidden="true">
      <span class="hearth-col-label">Light</span>
      <span class="hearth-col-label">Dark</span>
    </span>
  </div>
  <ul class="hearth-swatches space-y-1" data-reveal>
    {
      rows.map((row) => (
        <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 py-1.5">
          <span class="min-w-0">
            <span class="block truncate font-medium text-foreground">
              {row.label}
            </span>
            <span class="block text-sm text-subtle-foreground">{row.note}</span>
          </span>
          <span class="flex gap-2">
            {[row.light, row.dark].map((value) => (
              <button
                type="button"
                class="hearth-chip"
                data-copy={value}
                aria-label={`Copy ${value}`}
              >
                <span
                  class="hearth-chip-swatch"
                  style={`background-color: ${value}`}
                  aria-hidden="true"
                />
                <span class="hearth-chip-label">
                  <span class="hearth-chip-hex">{value}</span>
                  <span class="hearth-chip-copied" aria-hidden="true">
                    Copied
                  </span>
                </span>
              </button>
            ))}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hearth-col-label {
    width: 6.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--subtle-foreground);
  }

  /* Fixed width + centered content so the two chip columns line up under the
     Light / Dark labels regardless of hex length. */
  .hearth-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    transition: translate 150ms var(--ease-out-curve);
    cursor: pointer;
  }
  .hearth-chip::before {
    content: "";
    position: absolute;
    inset-block: -0.625rem;
    inset-inline: 0;
  }
  .hearth-chip:active {
    translate: 0 1px;
  }
  .hearth-chip:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .hearth-chip-swatch {
    width: 1rem;
    height: 1rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15);
  }
  .hearth-chip-label {
    display: grid;
    min-width: 3.5rem;
    text-align: center;
  }
  .hearth-chip-hex,
  .hearth-chip-copied {
    grid-area: 1 / 1;
    transition: opacity 150ms ease;
  }
  .hearth-chip-copied {
    color: var(--brand);
    opacity: 0;
  }
  .hearth-chip.is-copied .hearth-chip-hex {
    opacity: 0;
  }
  .hearth-chip.is-copied .hearth-chip-copied {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-chip {
      transition: none;
    }
    .hearth-chip-hex,
    .hearth-chip-copied {
      transition: none;
    }
  }
</style>
