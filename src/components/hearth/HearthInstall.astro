---
import { Code } from "astro:components";
import {
  CLI_INSTALL,
  DEFAULT_FLAVOR,
  FLAVORS,
  GITHUB_URL,
  MARKETPLACE_URL,
  VSIX_URL,
} from "@/lib/hearth/flavors";

const THEMES_URL = `${GITHUB_URL}/tree/main/themes`;
const hearthThemes = FLAVORS.find(({ id }) => id === DEFAULT_FLAVOR)?.themes;

if (!hearthThemes) throw new Error("The default Hearth theme is missing");

const SHIKI_SAMPLE = `import { codeToHtml } from "shiki";
import hearthDark from "./hearth-dark.json";

const html = await codeToHtml(code, {
  lang: "ts",
  theme: hearthDark,
});
`;

// Ports that exist as intent, not yet as theme files — they get a tab so the
// section answers for every target Hearth claims, rather than going quiet.
const SOON = [
  {
    id: "zed",
    label: "Zed",
    body: "a Hearth theme for the Zed editor is in the works.",
  },
  {
    id: "warp",
    label: "Warp",
    body: "a Hearth theme for the Warp terminal is in the works.",
  },
] as const;

const tabs = [
  { id: "vscode", label: "VS Code" },
  { id: "cursor", label: "Cursor" },
  ...SOON.map(({ id, label }) => ({ id, label })),
  { id: "shiki", label: "Shiki" },
];
---

<div class="hearth-install space-y-6" data-hearth-install>
  <div
    class="hearth-tablist flex gap-1 border-b border-border"
    role="tablist"
    aria-label="Install Hearth in"
  >
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`hearth-tab-${tab.id}`}
          aria-controls={`hearth-panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          class="hearth-tab"
        >
          {tab.label}
        </button>
      ))
    }
    <span class="hearth-tab-underline" data-tab-underline aria-hidden="true"
    ></span>
  </div>

  <div
    id="hearth-panel-vscode"
    role="tabpanel"
    aria-labelledby="hearth-tab-vscode"
    tabindex="0"
    class="hearth-panel"
  >
    <ol class="hearth-steps">
      <li>
        Install from the terminal — or search <strong>Hearth</strong> in the Extensions
        panel and click Install.
        <button
          type="button"
          class="hearth-cmd group"
          data-copy={CLI_INSTALL}
          aria-label={`Copy install command: ${CLI_INSTALL}`}
        >
          <span class="hearth-cmd-prompt" aria-hidden="true">$</span>
          <code class="hearth-cmd-text">{CLI_INSTALL}</code>
          <span class="hearth-cmd-hint" aria-hidden="true">Copy</span>
        </button>
      </li>
      <li>
        Open the theme picker with <kbd class="hearth-kbd">⌘K</kbd>{" "}
        <kbd class="hearth-kbd">⌘T</kbd> and choose a Hearth.
      </li>
    </ol>
    <a
      href={MARKETPLACE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="hearth-panel-link"
    >
      Open in Marketplace
    </a>
  </div>

  <div
    id="hearth-panel-cursor"
    role="tabpanel"
    aria-labelledby="hearth-tab-cursor"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        <a
          href={VSIX_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link"
          >Download the <code class="hearth-inline-code">.vsix</code></a
        > — always the current published build.
      </li>
      <li>
        In Cursor, open the Extensions panel, click <strong>⋯</strong> and{" "}
        <strong>Install from VSIX…</strong>, then select the file.
      </li>
      <li>
        Open the theme picker with <kbd class="hearth-kbd">⌘K</kbd>{" "}
        <kbd class="hearth-kbd">⌘T</kbd> and choose a Hearth.
      </li>
    </ol>
    <p class="hearth-note">
      Hearth isn't on Open VSX yet, so Cursor has no one-click install for now.
    </p>
  </div>

  {
    SOON.map(({ id, body }) => (
      <div
        id={`hearth-panel-${id}`}
        role="tabpanel"
        aria-labelledby={`hearth-tab-${id}`}
        tabindex="0"
        class="hearth-panel"
        hidden
      >
        <p class="hearth-soon">
          <strong>Coming soon</strong> — {body}
        </p>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-panel-link"
        >
          Watch the repo for the release
        </a>
      </div>
    ))
  }

  <div
    id="hearth-panel-shiki"
    role="tabpanel"
    aria-labelledby="hearth-tab-shiki"
    tabindex="0"
    class="hearth-panel"
    hidden
  >
    <ol class="hearth-steps">
      <li>
        Grab any of the six theme files from the <a
          href={THEMES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-inline-link">themes folder</a
        > — they're plain VS Code theme JSON.
      </li>
      <li>
        Pass one to Shiki as a <code class="hearth-inline-code">theme</code>:
      </li>
    </ol>
    <div class="hearth-shiki-code not-prose">
      <Code code={SHIKI_SAMPLE} lang="ts" themes={hearthThemes as never} />
    </div>
  </div>
</div>

<style>
  .hearth-tablist {
    position: relative;
  }
  .hearth-tab {
    position: relative;
    padding: 0.5rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    font-size: 0.9375rem;
    color: var(--subtle-foreground);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .hearth-tab::before {
    content: "";
    position: absolute;
    inset-block: -0.125rem;
    inset-inline: 0;
  }
  .hearth-tab:hover {
    color: var(--foreground);
  }
  .hearth-tab[aria-selected="true"] {
    color: var(--foreground);
    border-bottom-color: var(--brand);
  }
  .hearth-install[data-tab-underline-ready] .hearth-tab[aria-selected="true"] {
    border-bottom-color: transparent;
  }
  .hearth-tab:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  @media (min-width: 40rem) {
    .hearth-tab {
      padding-inline: 0.875rem;
    }
  }
  .hearth-tab-underline {
    position: absolute;
    inset-block-end: -1px;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: 2px;
    border-radius: var(--radius-full);
    background-color: var(--brand);
    opacity: 0;
    transform: translateX(0) scaleX(1);
    transform-origin: 0 50%;
    pointer-events: none;
    transition:
      transform 200ms cubic-bezier(0.645, 0.045, 0.355, 1),
      opacity 150ms var(--ease-out-curve);
  }
  .hearth-tab-underline[data-snap] {
    transition: none;
  }

  .hearth-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .hearth-panel:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  .hearth-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    counter-reset: step;
    max-width: 42rem;
  }
  .hearth-steps > li {
    position: relative;
    padding-inline-start: 2.25rem;
    color: var(--subtle-foreground);
    text-wrap: pretty;
  }
  .hearth-steps > li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: -0.1rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--brand);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .hearth-steps strong {
    font-weight: 500;
    color: var(--foreground);
  }

  .hearth-inline-link {
    text-underline-offset: 3px;
  }
  .hearth-inline-code {
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .hearth-note {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  /* Foreground, not the subtle tier: on the muted fill that tier measures
     4.38:1, just under AA. */
  .hearth-soon {
    max-width: 42rem;
    padding: 0.875rem 1.125rem;
    border-radius: var(--radius-lg);
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    text-wrap: pretty;
  }
  .hearth-soon strong {
    font-weight: 500;
  }
  .hearth-panel-link {
    font-size: 0.9375rem;
    text-underline-offset: 3px;
  }

  .hearth-shiki-code {
    width: 100%;
    max-width: 42rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .hearth-shiki-code :global(.astro-code) {
    margin: 0;
    padding: 1rem 1.125rem;
    font-size: 0.8125rem;
    line-height: 1.65;
  }
  :global(.dark) .hearth-shiki-code :global(.astro-code) {
    background-color: var(--shiki-dark-bg) !important;
  }

  .hearth-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.05rem 0.35rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .hearth-cmd {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-block-start: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-lg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--foreground);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    cursor: pointer;
    transition: translate 150ms var(--ease-out-curve);
  }
  .hearth-cmd:active {
    translate: 0 1px;
  }
  .hearth-cmd:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .hearth-cmd-prompt {
    color: var(--brand);
  }
  .hearth-cmd-hint {
    margin-inline-start: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--subtle-foreground);
  }
  .hearth-cmd.is-copied .hearth-cmd-hint {
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-tab,
    .hearth-cmd {
      transition: none;
    }
    .hearth-tab-underline {
      transition: none;
    }
  }
</style>

<script>
  const status = document.createElement("span");
  status.className = "sr-only";
  status.setAttribute("role", "status");
  status.setAttribute("aria-live", "polite");
  document.body.appendChild(status);

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-hearth-install]",
  )) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const tablist = root.querySelector<HTMLElement>(".hearth-tablist");
    const underline = root.querySelector<HTMLElement>("[data-tab-underline]");

    const moveUnderline = (tab: HTMLButtonElement, animate: boolean) => {
      if (!tablist || !underline) return;

      const currentRect = underline.getBoundingClientRect();
      const listRect = tablist.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      const ready = underline.hasAttribute("data-ready");
      const rtl = getComputedStyle(tablist).direction === "rtl";
      const inlineStart = rtl
        ? listRect.right - tabRect.right
        : tabRect.left - listRect.left;

      underline.setAttribute("data-snap", "");
      underline.style.insetInlineStart = `${inlineStart}px`;
      underline.style.inlineSize = `${tabRect.width}px`;
      underline.style.transform = "translateX(0) scaleX(1)";
      underline.style.opacity = "1";

      const targetRect = underline.getBoundingClientRect();
      if (animate && ready) {
        const delta = currentRect.left - targetRect.left;
        const scale = currentRect.width / targetRect.width;
        underline.style.transform = `translateX(${delta}px) scaleX(${scale})`;
      }

      underline.getBoundingClientRect();
      underline.removeAttribute("data-snap");
      underline.setAttribute("data-ready", "");
      root.setAttribute("data-tab-underline-ready", "");

      if (animate && ready) {
        requestAnimationFrame(() => {
          underline.style.transform = "translateX(0) scaleX(1)";
        });
      }
    };

    const select = (tab: HTMLButtonElement, focus = false, animate = false) => {
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute("aria-selected", active ? "true" : "false");
        other.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(
          other.getAttribute("aria-controls") ?? "",
        );
        if (panel) panel.hidden = !active;
      }
      moveUnderline(tab, animate);
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab, false, true));
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step) {
          event.preventDefault();
          select(tabs[(index + step + tabs.length) % tabs.length], true);
        } else if (event.key === "Home") {
          event.preventDefault();
          select(tabs[0], true);
        } else if (event.key === "End") {
          event.preventDefault();
          select(tabs[tabs.length - 1], true);
        }
      });
    });

    moveUnderline(tabs[0], false);
    if (tablist) {
      new ResizeObserver(() => {
        const active = tabs.find(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        if (active) moveUnderline(active, false);
      }).observe(tablist);
    }
  }

  for (const cmd of document.querySelectorAll<HTMLButtonElement>(
    ".hearth-cmd",
  )) {
    const hint = cmd.querySelector<HTMLElement>(".hearth-cmd-hint");
    let timer = 0;
    cmd.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmd.dataset.copy ?? "");
        cmd.classList.add("is-copied");
        if (hint) hint.textContent = "Copied";
        status.textContent = "Command copied to clipboard";
      } catch {
        status.textContent = "Copy failed";
        return;
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        cmd.classList.remove("is-copied");
        if (hint) hint.textContent = "Copy";
        status.textContent = "";
      }, 1100);
    });
  }
</script>
