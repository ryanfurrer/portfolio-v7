---
import { Code } from "astro:components";
import { cn } from "@/lib/utils";
import { segmentedItem } from "@/lib/segmented";
import HearthLanguageSelect from "./HearthLanguageSelect";
import {
  DEFAULT_EDITOR_LANGUAGE,
  DEFAULT_FLAVOR,
  EDITOR_SAMPLES,
  FLAVORS,
} from "@/lib/hearth/flavors";

// Shiki's ThemeRegistrationRaw type marks `settings` as required, but the runtime
// consumes VS Code `tokenColors`; the vendored Hearth JSON is valid at load. The
// cast bridges that gap (mirrors CodeBlock.astro).
const asTheme = (themes: { light: unknown; dark: unknown }) => themes as never;
---

<figure
  class="hearth-editor not-prose overflow-hidden rounded-xl border border-border bg-card shadow-elevated"
  data-hearth-editor
  data-flavor={DEFAULT_FLAVOR}
  data-language={DEFAULT_EDITOR_LANGUAGE}
>
  <div
    class="grid items-center gap-2 border-b border-border bg-muted px-3 py-3 sm:flex sm:gap-x-4 sm:px-4 sm:py-2.5"
  >
    <span class="hidden items-center gap-1.5 sm:flex" aria-hidden="true">
      <span class="size-3 rounded-full bg-foreground/15"></span>
      <span class="size-3 rounded-full bg-foreground/15"></span>
      <span class="size-3 rounded-full bg-foreground/15"></span>
    </span>
    <p class="hearth-file hidden sm:block" data-hearth-file>
      {EDITOR_SAMPLES[0].file}
    </p>
    <HearthLanguageSelect
      client:load
      initialValue={DEFAULT_EDITOR_LANGUAGE}
      options={EDITOR_SAMPLES.map(({ id, label }) => ({ id, label }))}
    />

    <div
      class="hearth-flavor-tabs flex w-full items-center gap-0.5 rounded-lg p-0.5 sm:ms-auto sm:w-auto"
      role="radiogroup"
      aria-label="Theme flavor"
    >
      {
        FLAVORS.map((flavor) => {
          const active = flavor.id === DEFAULT_FLAVOR;
          return (
            <button
              type="button"
              role="radio"
              aria-checked={active ? "true" : "false"}
              tabindex={active ? 0 : -1}
              data-flavor-btn={flavor.id}
              class={cn(
                segmentedItem({ active, variant: "raised" }),
                "relative flex flex-1 items-center justify-center gap-1.5 sm:flex-none",
              )}
            >
              <span
                class="size-2 rounded-full"
                style={`background-color: ${flavor.accent.light}`}
                data-accent-light={flavor.accent.light}
                data-accent-dark={flavor.accent.dark}
                aria-hidden="true"
              />
              <span class="hearth-tab-label" data-label={flavor.name}>
                <span>{flavor.name}</span>
              </span>
            </button>
          );
        })
      }
      <span class="hearth-flavor-slider" data-flavor-slider aria-hidden="true"
      ></span>
    </div>
  </div>

  <div class="hearth-canvas">
    {
      FLAVORS.flatMap((flavor) =>
        EDITOR_SAMPLES.map((sample) => (
          <div
            class="hearth-panel"
            data-flavor={flavor.id}
            data-language={sample.id}
            data-file={sample.file}
            hidden={
              flavor.id !== DEFAULT_FLAVOR ||
              sample.id !== DEFAULT_EDITOR_LANGUAGE
            }
          >
            <Code
              code={sample.code}
              lang={sample.lang}
              themes={asTheme(flavor.themes)}
              wrap={true}
            />
          </div>
        )),
      )
    }
  </div>
</figure>

<style>
  /* The chrome is site UI; the canvas is the theme's real editor surface. Light
     ships inline on the <pre>; dark rides --shiki-dark-bg, swapped in under
     .dark (the token color swap itself lives in the global prose rule). */
  .hearth-editor :global(.astro-code) {
    margin: 0;
    padding: 1rem 1rem 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  @media (min-width: 40rem) {
    .hearth-editor :global(.astro-code) {
      padding: 1.25rem 1.25rem 1.5rem;
    }
  }

  :global(.dark) .hearth-editor :global(.astro-code) {
    background-color: var(--shiki-dark-bg) !important;
  }

  .hearth-file {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--foreground);
  }

  [data-flavor-btn]::before {
    content: "";
    position: absolute;
    inset-block: -0.5rem;
    inset-inline: 0;
  }

  /* A well for the chip to lift out of. An inset ring rather than a border, so
     the track's box stays the geometry the slider measures against. */
  .hearth-flavor-tabs {
    position: relative;
    isolation: isolate;
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  /* Reserving the selected weight keeps selection from resizing the row. A
     resize fires the tablist's ResizeObserver, which repositions the slider
     with animation off — snapping it mid-slide. */
  .hearth-tab-label {
    display: grid;
  }
  .hearth-tab-label > span {
    grid-area: 1 / 1;
  }
  .hearth-tab-label::after {
    content: attr(data-label);
    grid-area: 1 / 1;
    font-weight: 500;
    visibility: hidden;
  }
  [data-flavor-btn] {
    z-index: 1;
  }
  .hearth-editor[data-flavor-slider-ready]
    [data-flavor-btn][aria-checked="true"] {
    background-color: transparent;
  }
  .hearth-flavor-slider {
    position: absolute;
    z-index: 0;
    inset-block: 0.125rem;
    inset-inline-start: 0;
    inline-size: 0;
    border-radius: var(--radius-md);
    background-color: var(--item-hover);
    box-shadow:
      var(--surface-raised-shadow),
      inset 0 0 0 1px var(--border);
    opacity: 0;
    transform: translateX(0) scaleX(1);
    transform-origin: 0 50%;
    pointer-events: none;
    transition:
      transform 200ms cubic-bezier(0.645, 0.045, 0.355, 1),
      opacity 150ms var(--ease-out-curve);
  }
  .hearth-flavor-slider[data-snap] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hearth-flavor-slider {
      transition: opacity 150ms ease;
    }
  }
</style>

<script>
  for (const editor of document.querySelectorAll<HTMLElement>(
    "[data-hearth-editor]",
  )) {
    const radios = [
      ...editor.querySelectorAll<HTMLButtonElement>("[data-flavor-btn]"),
    ];
    const panels = editor.querySelectorAll<HTMLElement>(".hearth-panel");
    const tablist = editor.querySelector<HTMLElement>(".hearth-flavor-tabs");
    const slider = editor.querySelector<HTMLElement>("[data-flavor-slider]");
    const dark = () => document.documentElement.classList.contains("dark");

    const paintDots = () => {
      for (const dot of editor.querySelectorAll<HTMLElement>(
        "[data-accent-light]",
      )) {
        dot.style.backgroundColor = dark()
          ? (dot.dataset.accentDark ?? "")
          : (dot.dataset.accentLight ?? "");
      }
    };

    const fileLabel = editor.querySelector<HTMLElement>("[data-hearth-file]");

    const syncPanel = () => {
      for (const panel of panels) {
        panel.hidden =
          panel.dataset.flavor !== editor.dataset.flavor ||
          panel.dataset.language !== editor.dataset.language;
        if (!panel.hidden && fileLabel && panel.dataset.file) {
          fileLabel.textContent = panel.dataset.file;
        }
      }
    };

    const moveSlider = (radio: HTMLButtonElement, animate: boolean) => {
      if (!tablist || !slider) return;

      const currentRect = slider.getBoundingClientRect();
      const listRect = tablist.getBoundingClientRect();
      const radioRect = radio.getBoundingClientRect();
      const ready = slider.hasAttribute("data-ready");
      const rtl = getComputedStyle(tablist).direction === "rtl";
      const inlineStart = rtl
        ? listRect.right - radioRect.right
        : radioRect.left - listRect.left;

      slider.setAttribute("data-snap", "");
      slider.style.insetInlineStart = `${inlineStart}px`;
      slider.style.inlineSize = `${radioRect.width}px`;
      slider.style.transform = "translateX(0) scaleX(1)";
      slider.style.opacity = "1";

      const targetRect = slider.getBoundingClientRect();
      if (animate && ready) {
        const delta = currentRect.left - targetRect.left;
        const scale = currentRect.width / targetRect.width;
        slider.style.transform = `translateX(${delta}px) scaleX(${scale})`;
      }

      slider.getBoundingClientRect();
      slider.removeAttribute("data-snap");
      slider.setAttribute("data-ready", "");
      editor.setAttribute("data-flavor-slider-ready", "");

      if (animate && ready) {
        requestAnimationFrame(() => {
          slider.style.transform = "translateX(0) scaleX(1)";
        });
      }
    };

    const selectFlavor = (id: string, focus = false, animate = false) => {
      editor.dataset.flavor = id;
      for (const radio of radios) {
        const active = radio.dataset.flavorBtn === id;
        radio.setAttribute("aria-checked", active ? "true" : "false");
        radio.tabIndex = active ? 0 : -1;
        // Mirror segmentedItem()'s raised variant. bg-card is the pre-slider
        // fallback; the ready state clears it and the slider carries the fill.
        radio.classList.toggle("bg-card", active);
        radio.classList.toggle("font-medium", active);
        if (active && focus) radio.focus();
      }
      syncPanel();
      const activeRadio = radios.find(
        (radio) => radio.dataset.flavorBtn === id,
      );
      if (activeRadio) moveSlider(activeRadio, animate);
    };

    radios.forEach((radio, index) => {
      radio.addEventListener("click", () =>
        selectFlavor(radio.dataset.flavorBtn ?? "", false, true),
      );
      radio.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" || event.key === "ArrowDown"
            ? 1
            : event.key === "ArrowLeft" || event.key === "ArrowUp"
              ? -1
              : 0;
        if (!step) return;
        event.preventDefault();
        const next = radios[(index + step + radios.length) % radios.length];
        selectFlavor(next.dataset.flavorBtn ?? "", true);
      });
    });

    const initialRadio = radios.find(
      (radio) => radio.getAttribute("aria-checked") === "true",
    );
    if (initialRadio) moveSlider(initialRadio, false);
    if (tablist) {
      new ResizeObserver(() => {
        const activeRadio = radios.find(
          (radio) => radio.getAttribute("aria-checked") === "true",
        );
        if (activeRadio) moveSlider(activeRadio, false);
      }).observe(tablist);
    }

    editor.addEventListener("hearth:language-change", (event) => {
      if (!(event instanceof CustomEvent)) return;
      const value = event.detail?.value;
      if (typeof value !== "string") return;
      editor.dataset.language = value;
      syncPanel();
    });

    // Keep the accent dots in sync when the site theme flips.
    paintDots();
    new MutationObserver(paintDots).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
