---
import { buttonVariants } from "@/components/ui/button";
import HearthEditor from "./HearthEditor.astro";
import HearthInstall from "./HearthInstall.astro";
import HearthMark from "./HearthMark.astro";
import HearthPalette from "./HearthPalette.astro";
import VariantGallery from "./VariantGallery.astro";
import {
  GITHUB_URL,
  HEARTH_KICKER,
  HEARTH_TAGLINE,
  MARKETPLACE_URL,
} from "@/lib/hearth/flavors";

const principles = [
  {
    title: "A quiet base",
    body: "Backgrounds, text, and comments stay in calm neutrals; the warmth lives in the code. Nothing competes with what you're reading.",
  },
  {
    title: "One accent, on purpose",
    body: "Keywords carry a single orange ember. Azure and Teal add just one cool hue — on functions and types — so structure pops without a rainbow.",
  },
  {
    title: "Beyond the editor",
    body: "VS Code, Cursor, Zed, and Warp — and the same theme files highlight code anywhere Shiki runs, including this page.",
  },
];
---

<div class="mx-auto max-w-5xl space-y-24 px-6 py-16 sm:py-24">
  <section class="space-y-8" data-reveal>
    <div class="space-y-5">
      <span class="flex items-center gap-2.5">
        <span class="small-heading text-subtle-foreground!">
          {HEARTH_KICKER}
        </span>
      </span>
      <h1
        class="text-5xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl"
      >
        Hearth
      </h1>
      <p class="lead max-w-xl text-xl!">{HEARTH_TAGLINE}</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <a
        href={MARKETPLACE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants({ size: "lg" })}
      >
        Install for VS Code
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants({ variant: "outline", size: "lg" })}
      >
        View on GitHub
      </a>
    </div>
  </section>

  <section data-reveal>
    <HearthEditor />
  </section>

  <section class="grid gap-x-10 gap-y-8 sm:grid-cols-3" data-reveal>
    {
      principles.map((principle) => (
        <div class="space-y-2">
          <h2 class="text-base font-medium text-foreground">
            {principle.title}
          </h2>
          <p class="text-sm text-pretty text-subtle-foreground">
            {principle.body}
          </p>
        </div>
      ))
    }
  </section>

  <section class="space-y-6">
    <div class="space-y-2" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        Install
      </h2>
      <p class="text-pretty text-subtle-foreground">
        Editor, terminal, or docs — pick where Hearth lives next.
      </p>
    </div>
    <div data-reveal>
      <HearthInstall />
    </div>
  </section>

  <section class="space-y-8">
    <div class="space-y-2" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        Six variants
      </h2>
      <p class="max-w-xl text-pretty text-subtle-foreground">
        Three flavors, each a light and dark pair. Every card below is rendered
        in its own theme — whatever mode you're viewing in.
      </p>
    </div>
    <VariantGallery />
  </section>

  <section class="space-y-8">
    <div class="space-y-2" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        The palette
      </h2>
      <p class="max-w-xl text-pretty text-subtle-foreground">
        The base palette is identical across flavors; only functions and types
        take on the accent hue. Every value is the real one from the theme files
        — click to copy.
      </p>
    </div>
    <HearthPalette />
  </section>

  <section
    class="flex flex-col items-center gap-6 rounded-xl bg-muted px-6 py-14 text-center"
    data-reveal
  >
    <HearthMark class="size-10" />
    <h2
      class="text-2xl font-semibold tracking-tight text-balance text-foreground"
    >
      Make your editor feel like home.
    </h2>
    <a
      href={MARKETPLACE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonVariants({ size: "lg" })}
    >
      Install Hearth
    </a>
  </section>
</div>
