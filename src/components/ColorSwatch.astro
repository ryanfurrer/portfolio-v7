---
interface Props {
  token: string;
  label: string;
  util: string;
  note: string;
}

const { token, label, util, note } = Astro.props;
---

<button
  type="button"
  data-swatch={token}
  aria-label={`Copy the ${label} colour value`}
  class="group/swatch flex w-full items-center gap-3 rounded-lg p-2 text-start transition-colors hover:bg-surface focus-visible:bg-surface"
>
  <span
    class="size-12 shrink-0 rounded-md ring-1 ring-inset ring-border"
    style={`background-color: var(${token})`}
    aria-hidden="true"></span>
  <span class="min-w-0 flex-1">
    <span class="flex items-baseline gap-2">
      <span class="font-medium text-foreground">{label}</span>
      <span
        data-swatch-value
        class="font-mono-custom truncate text-xs text-subtle-foreground"
        >…</span
      >
    </span>
    <span class="mt-0.5 block text-sm text-pretty text-muted-foreground">
      <span class="font-mono-custom text-xs">{util}</span> — {note}
    </span>
  </span>
  <svg
    class="size-4 shrink-0 self-start text-muted-foreground opacity-0 transition-opacity can-hover:group-hover/swatch:opacity-100 group-focus-visible/swatch:opacity-100"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
    <path
      d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"
    ></path>
  </svg>
</button>
